# The harness image. Builds to ghcr.io/agoraforge/harness-rails.
#
# Honours the Vilice deploy contract: runs as a non-root user and listens on an
# unprivileged port (PORT, default 8080) on 0.0.0.0. No master key is baked in — the app
# is stateless, so production runs with an ephemeral SECRET_KEY_BASE_DUMMY.
ARG RUBY_VERSION=4.0.3

FROM docker.io/library/ruby:${RUBY_VERSION}-slim AS base
WORKDIR /app
ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=development:test \
    SECRET_KEY_BASE_DUMMY=1 \
    PORT=8080

FROM base AS build
RUN apt-get update -qq \
 && apt-get install --no-install-recommends -y build-essential \
 && rm -rf /var/lib/apt/lists/*
COPY Gemfile Gemfile.lock ./
RUN bundle install \
 && rm -rf "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git
COPY . .

FROM base
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /app /app

# Non-root, and a data dir the app can own (DATA_DIR points here for the counter knob).
RUN useradd --uid 1000 --user-group --create-home harness \
 && mkdir -p /data && chown -R harness:harness /app /data
USER harness

EXPOSE 8080
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
