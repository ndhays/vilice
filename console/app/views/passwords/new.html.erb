<% content_for :title, "Reset Password — Steward Console" %>

<div class="auth">
  <div class="auth-card">
    <%= render "shared/auth_brand" %>
    <h1 class="auth-title">Reset your password</h1>

    <%= form_with url: passwords_path, class: "stack-form" do |form| %>
      <label class="field"><span>Email</span>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username", value: params[:email_address],
              placeholder: "you@example.com" %></label>

      <div class="form-actions">
        <%= button_tag class: "btn mutate" do %>
          <%= safe_join([ icon("mail", size: 14), "Email Reset Instructions" ], " ") %>
        <% end %>
        <%= link_to "Back to sign in", new_session_path, class: "auth-link" %>
      </div>
    <% end %>
  </div>
</div>
