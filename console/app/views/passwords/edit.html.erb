<% content_for :title, "Set New Password — Steward Console" %>

<div class="auth">
  <div class="auth-card">
    <%= render "shared/auth_brand" %>
    <h1 class="auth-title">Choose a new password</h1>

    <%= form_with url: password_path(params[:token]), method: :put, class: "stack-form" do |form| %>
      <label class="field"><span>New password</span>
        <%= form.password_field :password, required: true, autofocus: true,
              autocomplete: "new-password", maxlength: 72, placeholder: "••••••••" %></label>
      <label class="field"><span>Repeat new password</span>
        <%= form.password_field :password_confirmation, required: true,
              autocomplete: "new-password", maxlength: 72, placeholder: "••••••••" %></label>

      <div class="form-actions">
        <%= button_tag class: "btn mutate" do %>
          <%= safe_join([ icon("save", size: 14), "Save" ], " ") %>
        <% end %>
        <%= link_to "Back to sign in", new_session_path, class: "auth-link" %>
      </div>
    <% end %>
  </div>
</div>
