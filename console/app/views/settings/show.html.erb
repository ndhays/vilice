<% content_for :title, "Settings — Vilice" %>

<h1>Settings</h1>

<div class="fleet-info">
  <p class="muted">Signed in as <span class="mono"><%= @user.email_address %></span> ·
    <%= pluralize(@project_count, "project") %> ·
    <%= pluralize(@machine_count, "machine") %> (<%= @shared_count %> shared)</p>
</div>

<%# Fleet policy. Its Save lives in the card, like every other card here — it used to
    sit loose beneath, from when one form spanned several cards. %>
<div class="card setting">
  <div class="title">Apps</div>
  <%= form_with model: @setting, url: settings_path, method: :patch do |f| %>
    <label class="toggle">
      <%= f.check_box :apps_library_only %>
      <span>Only allow apps from App Library templates (no custom images)</span>
    </label>
    <div class="card-actions">
      <%= button_tag class: "btn" do %>
        <%= safe_join([ icon("save", size: 14), "Save Settings" ]) %>
      <% end %>
    </div>
  <% end %>
</div>

<%# This console, on its own box: where it runs, and updating it there. `vilice update`
    re-deploys the spec the box holds with only the image changed, so the console's
    secrets stay where they are (decisions/update-is-rollback-pointed-forward.md). %>
<div class="card setting" id="this-console">
  <div class="title">This Console</div>
  <% box = @setting.self_machine %>
  <% if box && @self_on_box %>
    <dl class="facts">
      <dt>Runs as</dt><dd><span class="mono"><%= @setting.self_app_name %></span> on <%= link_to box.name, box %></dd>
      <dt>Image</dt><dd><%= digest_chip(@self_on_box["image"]) %></dd>
      <% if (last = @self_on_box["update"]) %>
        <dt>Last update</dt>
        <dd>
          <% if last["state"] == "ok" %>
            to <%= digest_chip(last["image"]) %>, done
          <% elsif last["state"] == "failed" %>
            <strong>failed</strong> — to <%= digest_chip(last["image"]) %>:
            <span class="mono"><%= last["message"].to_s.truncate(300) %></span>
          <% else %>
            to <%= digest_chip(last["image"]) %>, <%= last["state"] %>…
          <% end %>
        </dd>
      <% end %>
    </dl>
    <%= form_with url: settings_update_console_path, method: :post, class: "stack-form",
          data: { controller: "busy", action: "submit->busy#start" } do |f| %>
      <label class="field">
        <span>New image</span>
        <%= f.text_field :image, class: "mono", required: true, autocomplete: "off", spellcheck: false,
              placeholder: "registry.example.com/vilice-console@sha256:…" %>
        <small class="muted">Pinned by digest, as <span class="mono">make push</span> prints it.
          Only the image changes: settings, secrets and storage stay as they are on the box.</small>
      </label>
      <p class="ceremony-runs">Recorded, then run over scoped SSH:</p>
      <%= command_block("vilice update #{@setting.self_app_name} --image <image>") %>
      <p class="note muted">It runs in the background on the box. This version keeps answering
        until the new one passes its health check; if it fails, nothing changes, and the
        reason shows here.</p>
      <div class="card-actions">
        <%= button_tag vilice_verb("update"), class: "btn mutate cmd" %>
      </div>
    <% end %>
  <% elsif box %>
    <p class="note"><%= box.name %> reports no app named <span class="mono"><%= @setting.self_app_name %></span>
      — check the name below, or that the box answers.</p>
  <% else %>
    <p class="note muted">To update this console from here, say which machine it runs on.
      That machine needs an operate key.</p>
  <% end %>
  <details class="paste-spec" <%= "open" unless box %>>
    <summary>Where this console runs</summary>
    <%= form_with url: settings_self_path, method: :patch, class: "stack-form" do |f| %>
      <label class="field"><span>Machine</span>
        <%= select_tag :self_machine_id, options_from_collection_for_select(@self_machines, :id, :name, box&.id),
              include_blank: "Not set" %></label>
      <label class="field"><span>App name on that machine</span>
        <%= text_field_tag :self_app_name, @setting.self_app_name, class: "mono", autocomplete: "off", spellcheck: false %></label>
      <div class="card-actions">
        <%= button_tag class: "btn" do %>
          <%= safe_join([ icon("save", size: 14), "Save" ]) %>
        <% end %>
      </div>
    <% end %>
  </details>
</div>

<%# Appearance — yours, not the fleet's, so it saves on its own. A theme is a set of
    token values; mode picks its light or dark half, or follows your system. %>
<div class="card setting appearance">
  <div class="title">Appearance</div>
  <%= form_with url: settings_appearance_path, method: :patch, class: "stack-form" do |f| %>
    <label class="field"><span>Theme</span>
      <%= f.select :theme,
            Theme::ALL.map { |t| [ t.label, t.name ] }, { selected: @user.theme } %>
    </label>
    <p class="note muted"><%= Theme.find(@user.theme).blurb %></p>
    <label class="field"><span>Mode</span>
      <%= f.select :mode,
            Theme::MODES.map { |m| [ Theme::MODE_LABELS[m], m ] }, { selected: @user.mode } %>
    </label>
    <p class="note muted">Every theme has a light and a dark half. Following your
      system is the default.</p>
    <div class="card-actions">
      <%= button_tag class: "btn" do %>
        <%= safe_join([ icon("save", size: 14), "Save Appearance" ]) %>
      <% end %>
    </div>
  <% end %>
</div>

<%# Account — change your own password (separate form from the fleet settings above). %>
<div class="card setting account">
  <div class="title">Change Password</div>
  <%= form_with url: settings_password_path, method: :patch, class: "stack-form" do |f| %>
    <label class="field"><span>Current password</span>
      <%= f.password_field :current_password, required: true, autocomplete: "current-password",
            maxlength: 72 %></label>
    <label class="field"><span>New password</span>
      <%= f.password_field :password, required: true, autocomplete: "new-password",
            maxlength: 72 %></label>
    <label class="field"><span>Repeat new password</span>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
            maxlength: 72 %></label>
    <div class="card-actions">
      <%= button_tag class: "btn" do %>
        <%= safe_join([ icon("lock", size: 14), "Change Password" ]) %>
      <% end %>
    </div>
  <% end %>
</div>

<% if Rails.env.local? %>
  <div class="card setting danger-zone">
    <div class="title">Danger zone (development only)</div>
    <div class="card-actions">
      <%= button_to settings_data_path, method: :delete, class: "btn-quiet danger",
            form: { data: { turbo_confirm: "Erase ALL fleet data? This cannot be undone." } } do %>
        <%= safe_join([ icon("trash-2", size: 14), "Erase All Data" ]) %>
      <% end %>
    </div>
  </div>
<% end %>

<section class="about">
  <h2>About</h2>
  <p class="muted"><strong>Vilice</strong> is the control plane for your app's fleet — projects, machines,
    and apps in one place, with every change written to an accountable record.<br/><br/>
    <strong>Vilice</strong> is its command-line companion: a single Go binary (no daemon)
    that runs scoped deploys and operations against your machines.</p>

  <dl class="about-meta">
    <div>
      <dt>Documentation Website</dt>
      <dd><a href="https://vilice.org">vilice.org</a></dd>
    </div>
    <div>
      <dt>Code Repository</dt>
      <dd><a href="https://github.com/ndhays/vilice">github.com/ndhays/vilice</a></dd>
    </div>
    <div>
      <dt>Version</dt>
      <dd class="mono"><%= @version %></dd>
    </div>
    <div>
      <dt>License</dt>
      <dd><a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0-or-later</a></dd>
    </div>
  </dl>
</section>
