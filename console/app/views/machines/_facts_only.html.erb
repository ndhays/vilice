<%# What the box *is*, on one line: a row of labelled cells. Locals: machine, status (nil
    until read). Replaced whole by the live frame once the box has answered. %>
<table class="facts-table" id="machine-facts">
  <thead>
    <tr>
      <th>Address</th><th>Role</th><th>Owned by</th><th>Used by</th>
      <%# The name mirrors the box (decisions/machine-name-mirrors-the-box.md), so the name
          the box reports is only news when the two differ. %>
      <% box_says = status&.online? && status.hostname.present? && status.hostname != machine.name %>
      <% clients = machine.projects.where.not(id: machine.owner_id) %>
      <% if box_says %><th>Box says</th><% end %>
      <% if clients.any? %><th>Also serves</th><% end %>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="mono"><%= ssh_address(machine) %></td>
      <td><%= machine_role_word(machine, status) %></td>
      <td><%= machine.owner ? safe_join([ "project ", link_to(machine.owner.name, machine.owner) ]) : tag.span("no project", class: "fact-gap", title: "No project can put apps on it until one owns it or it is shared — see Settings") %></td>
      <td><%= sharing_mode_label(machine.sharing) %></td>
      <% if box_says %><td class="mono" title="The hostname the box reports; the name here has not caught up"><%= status.hostname %></td><% end %>
      <% if clients.any? %><td><%= safe_join(clients.map { |p| link_to(p.name, p) }, ", ") %></td><% end %>
    </tr>
  </tbody>
</table>
