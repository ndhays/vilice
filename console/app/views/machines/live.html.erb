<%# The half of the machine page that needs the box: the status quick view, the apps and the record. The
    shell (show) renders at once and this frame fills in when the SSH reads return
    (MachinesController#live), so a slow or unreachable box never holds the page blank.
    The frame's links and forms go to the top by default (`target: "_top"` on the frame);
    only a ceremony opens in place, in its card.

    It also replaces the shell's header and facts with the live ones: a turbo-stream
    inside a frame runs when the frame is inserted. %>
<%= turbo_frame_tag "machine-live", target: "_top" do %>
  <%= turbo_stream.replace "machine-head", partial: "machines/head_only", locals: { machine: @machine, status: @status } %>
  <%= turbo_stream.replace "machine-facts", partial: "machines/facts_only", locals: { machine: @machine, status: @status } %>

<%# ── A quick view, then the apps ───────────────────────────────────────────────
    The machine page is for looking. It shows how the box is and what runs on it, and
    each line leads one level down: a status line to the Machine Status page, an app
    line to that app's page. The acts are down there, beside what they act on
    (decisions/acts-sit-with-what-they-act-on.md). The one act here is `deploy`, with
    the apps list, because putting an app on the box is not an act on any one app.

    `acts` is whether this key may act at all. %>
<% acts = @machine.operate? && @status.online? %>

<%# When the box does not answer we know **nothing current** about it, so the page
    does not lay out empty cards that each apologise in their own words. One card
    owns the message, and no act is offered: every act travels the same connection.
    Our own record stays at full strength further down. %>
<% if !@status.online? %>
  <div class="panel unreachable">
    <div class="panel-head">
      <div class="kicker">Unreachable</div>
      <%= button_to refresh_machine_path(@machine), class: "btn cmd observe sm panel-action", title: "Read the box again" do %>
        <%= vilice_verb "status" %>
      <% end %>
    </div>
    <p class="unreachable-line">
      <%= icon "circle-cut", size: 18 %>
      Vilice could not reach <strong><%= @machine.name %></strong><%
        %><% if @machine.last_seen_at %>, last heard from <%= time_ago_in_words(@machine.last_seen_at) %> ago<% end %>.
    </p>
    <pre class="raw"><%= @status.error %></pre>
  </div>
<% else %>
<% unless @machine.operate? %>
  <p class="note observe-only"><%= icon "lock", size: 14 %>
    This box holds an <strong>observe</strong> key: Vilice can read it, not act on it.
    Grant <strong>operate</strong> to act here.</p>
<% end %>
<%# ── Status, at a glance ────────────────────────────────────────────────────
    The quick view: how full the box is, as bars, then a chip for each other thing about
    it, saying how it is. Nothing here acts and nothing is folded away — a chip with a
    problem is coloured, and every chip leads to its part of the Machine Status page,
    where the detail and the acts are (blueprint/console/interface.md). %>
<%# The whole card is the way to Machine Status: the title carries the link and it is
    stretched over the card. The `status` button and the chips sit above it — the button
    re-reads the box (a POST, so a hover cannot fire an SSH connection), and each chip
    goes to its own part of the page. %>
<div class="panel observe quick-view">
  <div class="quick-head">
    <%= link_to "Status", status_machine_path(@machine), class: "kicker card-link", title: "Machine status, in full" %>
    <span class="read-age"><%= read_age(@status) %></span>
    <%= button_to refresh_machine_path(@machine), class: "btn cmd observe sm", title: "Read the box again" do %>
      <%= vilice_verb "status" %>
    <% end %>
  </div>
  <%# How full it is, as bars; how busy and how long up, as words. %>
  <div class="usage-row">
    <%= usage_bar "Memory", percent: @status.mem_percent, level: @status.mem_level, icon_name: "memory-stick",
          used: @status.mem_used_bytes, total: @status.mem_total_bytes %>
    <%= usage_bar "Disk", percent: @status.disk_percent, level: @status.disk_level, icon_name: "hard-drive",
          used: @status.disk_used_bytes, total: @status.disk_total_bytes %>
    <p class="usage-words">
      <span><%= icon "cpu", size: 13 %> load <strong><%= @status.load1 %></strong></span>
      <span><%= icon "clock", size: 13 %> up <strong><%= distance_of_time_in_words(0, @status.uptime_sec) %></strong></span>
    </p>
  </div>
  <%# Everything else about the box, on one line: a chip each, coloured when it needs
      you, and each the link to its part of Machine Status. %>
  <p class="status-chips">
    <%= status_chip @machine, "Hardening", hardening_summary(@status), "status", @status.hardened? ? "lock" : "lock-open" %>
    <%= status_chip @machine, "Maintenance", maintenance_summary(@status), "maintenance", "stethoscope" %>
    <% unless @status.balancer? %>
      <%= status_chip @machine, "Registries", registries_summary(@status), "registries", "library-big" %>
    <% end %>
    <% if @status.certs.any? %>
      <%= status_chip @machine, "Certificates", certs_summary(@status), "certificates", "shield" %>
    <% end %>
    <%= status_chip @machine, "Record", record_summary(@status, @record), "record", "disc" %>
    <%= status_chip @machine, "Access", access_summary(@machine, @actors), "access", "key-round" %>
  </p>
</div>

  <%# ── Apps ──────────────────────────────────────────────────────────────────
      What the box says is running, which is the reason the box exists. One line per
      app: how it is doing, the digest it is actually running, and the way to its own
      page — where its acts are. Every app the box reports has that page, held in our
      record or not. Absent only where the box says it is a balancer. %>
  <% unless @status.balancer? %>
    <div class="panel observe">
      <div class="kicker">Apps on this box</div>
      <% if @status.apps.empty? %>
        <p class="muted">No apps on this box.</p>
      <% else %>
        <ul class="rows app-box-rows">
          <% @status.apps.each do |box_app| %>
            <% app = @apps.find { |i| i.name == box_app["name"] } %>
            <li class="row">
              <span class="cell-name">
                <%= icon "box", size: 15, css_class: "icon row-icon" %>
                <%= link_to box_app["name"], machine_box_app_path(@machine, box_app["name"]), class: "row-name" %>
              </span>
              <span class="cell-state"><%= box_app_state(box_app) %></span>
              <%# Where it answers: a link that opens the app itself, in a new tab. %>
              <span class="cell-hosts"><%= host_links(box_app["hostnames"], more_path: machine_box_app_path(@machine, box_app["name"])) %></span>
              <%# How much of the box it is using, then two marks — its certificates and its
                  backup — that stay quiet unless something is wrong. %>
              <span class="cell-memory"><%= app_memory_bar(@status, box_app) %></span>
              <span class="cell-marks"><%= app_cert_mark(@status, box_app["name"]) %><%= app_backup_mark(@status, box_app["name"]) %></span>
              <span class="cell-project">
                <% if app&.project %>
                  <%= link_to app.project.name, app.project, class: "owner-link" %>
                <% end %>
              </span>
              <span class="cell-image"><%= digest_chip(box_app["image"]) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <%# Placements we hold that the box did not report back. The gap is stated, never
          closed on its own (decisions/drift-is-surfaced-never-closed.md). %>
      <% missing = @apps.reject { |i| @status.apps.any? { |a| a["name"] == i.name } } %>
      <% if missing.any? %>
        <p class="note muted">
          <%= icon "triangle-alert", size: 13 %>
          Placed here but not reported running:
          <%= safe_join(missing.map { |i| link_to(i.name, machine_box_app_path(@machine, i.name)) }, ", ") %>.
        </p>
      <% end %>
      <% if acts %>
        <%= render "machines/act", verb: "deploy",
              state: "Deploy an app to this box",
              button: link_to(vilice_verb("deploy"), new_machine_box_app_path(@machine), class: "btn mutate cmd sm") %>
      <% end %>
    </div>
  <% end %>

  <%# ── The edge, when this box is a balancer ───────────────────────────────
      Two halves, kept visibly apart: the table this box *should* serve, derived from
      the apps that select it, and the addresses it *reports* fronting. Nothing
      reconciles them — sending the table is the act on this card. %>
  <% if @machine.balancer? %>
    <div class="panel observe">
      <div class="kicker">Edge · derived from the apps behind it</div>
      <% if @table.any? %>
        <ul class="route-table">
          <% @table.each do |r| %>
            <li>
              <span class="route-host mono"><%= r.hostnames.join(" ") %></span>
              <span class="route-arrow">→</span>
              <span class="route-ups mono"><%= r.upstreams.join(", ") %></span>
              <%= link_to r.app.name, r.app, class: "route-app" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="note muted">No app selects this balancer yet, so the table is empty.</p>
      <% end %>
      <p class="note muted">
        <% if @status.routes.any? %>
          Box reports fronting: <span class="mono"><%= @status.routes.join(", ") %></span>
        <% else %>
          Box reports fronting nothing yet.
        <% end %>
      </p>
      <% if acts %>
        <%= render "machines/act", verb: "route",
              state: @table.any? ? "Send the edge table: #{pluralize(@table.size, 'app')} behind it" : "Send the edge table (no app selects this box yet)",
              button: act_button(@machine, "route", frame: "ceremony-edge") %>
        <%= turbo_frame_tag "ceremony-edge" %>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# ── Record — this box's half of the two records, newest first ─────────────── %>
<h2 class="section-kicker"><%= icon "disc", size: 15 %> Record</h2>
<%# Online, the Record card above says whether the chain is intact. Offline there is no
    card, so the warning that these entries end at the last read belongs with them. %>
<%= record_integrity(@record) unless @status.online? %>
<%# The chain is assembled from two sources — our own events and the box's — so the
    search filters the assembled list rather than a relation. A plain GET, so a
    narrowed record stays a link you can send. %>
<%= form_with url: machine_path(@machine), method: :get, class: "filter-bar" do |f| %>
  <span class="filter-search">
    <%= icon "search", size: 15 %>
    <%= f.search_field :q, value: @q, autocomplete: "off", spellcheck: false,
          placeholder: "Search this box's record" %>
  </span>
  <%= f.submit "Search", class: "btn sm" %>
  <% if @q.present? %>
    <%= link_to "Clear", machine_path(@machine), class: "filter-clear" %>
  <% end %>
<% end %>
<% if @chain.empty? && @q.present? %>
  <p class="empty">Nothing in this box's record matches. <%= link_to "Clear it", machine_path(@machine) %>.</p>
<% else %>
  <%= render "events/chain", items: @chain, within: @machine %>
<% end %>
<% end %>
