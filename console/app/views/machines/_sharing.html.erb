<%# Ownership & sharing — who owns the box and which projects may pick it up. The
    guardrail that stops one client's box landing on another's project lives behind
    these controls (decisions/machine-ownership.md). Each change is a recorded act. %>
<div class="panel access-panel">
  <div class="kicker">Ownership &amp; sharing</div>

  <div class="own-row">
    <span class="own-label">Owner</span>
    <% if machine.owner %>
      <%= link_to machine.owner.name, machine.owner, class: "own-name" %>
    <% else %>
      <span class="badge unowned">unowned</span>
    <% end %>
    <%= form_with url: transfer_machine_path(machine), method: :patch, class: "inline-form" do %>
      <%= select_tag "machine[owner_id]",
            options_from_collection_for_select(projects, :id, :name, machine.owner_id),
            include_blank: "— release to no one —", class: "select" %>
      <%= button_tag "Transfer", class: "btn sm" %>
    <% end %>
  </div>

  <%= form_with url: sharing_machine_path(machine), method: :patch, class: "sharing-form" do %>
    <fieldset class="sharing-modes">
      <% Machine.sharings.keys.each do |mode| %>
        <label class="radio <%= "on" if machine.sharing == mode %>">
          <%= radio_button_tag "machine[sharing]", mode, machine.sharing == mode %>
          <span class="radio-label"><%= sharing_mode_label(mode) %></span>
          <small class="radio-hint"><%= sharing_mode_hint(mode) %></small>
        </label>
      <% end %>
    </fieldset>
    <%= button_tag "Save sharing", class: "btn sm" %>
  <% end %>

  <% if machine.sharing_list? %>
    <div class="allowlist">
      <h3>Allowed projects</h3>
      <% if machine.granted_projects.any? %>
        <ul class="grant-rows">
          <% machine.machine_grants.includes(:project).each do |grant| %>
            <li>
              <%= link_to grant.project.name, grant.project %>
              <%= button_to machine_grant_path(machine, grant), method: :delete,
                    class: "btn-quiet danger sm", form: { data: { turbo_confirm:
                    "Remove #{grant.project.name} from #{machine.name}?" } } do %>
                <%= icon "trash-2", size: 13 %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="note muted">No projects allowed yet — only the owner can use this box.</p>
      <% end %>
      <% addable = projects.reject { |p| p.id == machine.owner_id || machine.granted_projects.include?(p) } %>
      <% if addable.any? %>
        <%= form_with url: machine_grants_path(machine), method: :post, class: "inline-form" do %>
          <%= select_tag :project_id, options_from_collection_for_select(addable, :id, :name),
                prompt: "Allow a project…", class: "select" %>
          <%= button_tag "Allow", class: "btn sm" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
