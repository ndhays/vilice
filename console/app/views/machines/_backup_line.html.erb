<%# When one target last backed up, as the box's own `backup` noted it. Never a live
    query of the repo. Locals: row (MachineStatus::BackupRow). %>
<p class="backup-line <%= row.failing? ? 'bad' : (row.never? ? 'warn' : 'ok') %>">
  <% if row.failing? %>
    <%= icon "circle-x", size: 14 %> Last backup failed <%= time_ago_in_words(row.last_failed) %> ago<%
      %><% if row.last_ok %> · last good <%= time_ago_in_words(row.last_ok) %> ago<% end %>
  <% elsif row.never? %>
    <%= icon "triangle-alert", size: 14 %> Never backed up
  <% else %>
    <%= icon "circle-check", size: 14 %> Backed up <%= time_ago_in_words(row.last_ok) %> ago
  <% end %>
</p>
<% if row.failing? && row.error.present? %>
  <p class="muted card-note mono"><%= row.error %></p>
<% end %>
