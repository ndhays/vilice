<% content_for :title, "Machines — Vilice" %>

<%= page_header "All Machines" do %>
  <%= button_link_to "Add Machine", new_machine_path, icon: "plus", class: "btn" %>
<% end %>

<%# The headline — this layer's story in one line. It states only facts the floor
    owns: how many boxes there are, how many can't be reached, how many we've never
    met. The moment it mentions apps or clients it has reached up a ring. %>
<p class="headline">
  <%= pluralize(@total, "box", plural: "boxes") %><%
    %><% if @unreachable.positive? %> · <span class="bad"><%= @unreachable %> unreachable</span><% end %><%
    %><% if @never_seen.positive? %> · <span class="muted"><%= @never_seen %> not yet seen</span><% end %><%
    %><% if @unreachable.zero? && @never_seen.zero? && @total.positive? %> · <span class="ok">all reachable</span><% end %>
</p>

<%= render layout: "shared/list_toolbar",
      locals: { search_url: machines_path, q: @q, placeholder: "name  ·  key=value label",
                selectable: false, hidden: { group: (@group unless @group == "none") } } do %><% end %>

<%# Group by — the primitive this page is built on. Each choice is a link, so the
    grouped view has its own URL and can be shared or bookmarked, the same rule the
    Record destination follows. %>
<div class="action-chips filter-row" role="group" aria-label="Group the fleet by">
  <span class="chip-label muted">Group by</span>
  <% MachineGroups::ALL.each do |grouping| %>
    <%= link_to machines_path(group: grouping.key, q: @q),
          class: "chip #{'on' if @group == grouping.key}",
          "aria-pressed": (@group == grouping.key).to_s do %>
      <%= grouping.label %>
    <% end %>
  <% end %>
</div>

<%# The operator's own axis, on its own line — the system's groupings and the ones
    you invented are different kinds of thing, and a single run of chips read as one
    undifferentiated list. Only keys actually in use are offered. %>
<% if @label_keys.any? %>
  <div class="action-chips filter-row" role="group" aria-label="Group the fleet by label">
    <span class="chip-label muted">Labels</span>
    <% @label_keys.each do |key| %>
      <% chip_key = "#{MachineGroups::LABEL_PREFIX}#{key}" %>
      <%= link_to machines_path(group: chip_key, q: @q),
            class: "chip #{'on' if @group == chip_key}",
            "aria-pressed": (@group == chip_key).to_s do %>
        <%= icon "tag", size: 13 %><%= key %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @machines.any? %>
  <%# `key` changes whenever the grouping does, so Turbo replaces the list rather
      than morphing it — the 150ms fade in lists.css is the whole of the motion,
      and nothing moves layout (blueprint/design/tokens.md). %>
  <div class="grouped-list" key="machines-<%= @group %>">
    <% @groups.each do |heading, machines| %>
      <% if heading %>
        <h2 class="group-head">
          <span class="group-name"><%= heading %></span>
          <span class="group-count"><%= machines.size %></span>
        </h2>
      <% end %>
      <%# Only a group actually headed by a balancer draws the tree; "No balancer" is
          a plain list, because there is no edge for those boxes to sit under. %>
      <% fleet = @group == "fleet" && machines.any?(&:balancer?) %>
      <ul class="rows machine-rows<%= " fleet-rows" if fleet %>">
        <%= render partial: "machines/row", collection: machines, as: :machine,
              locals: { show_owner: false, fleet: fleet } %>
      </ul>
    <% end %>
  </div>
<% elsif @q.present? %>
  <p class="empty">No machines match this search.</p>
<% else %>
  <p class="empty">No machines yet.</p>
<% end %>
