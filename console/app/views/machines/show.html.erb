<% content_for :title, "#{@machine.name} — Steward" %>

<%= breadcrumb [["Machines", machines_path], [@machine.name, nil]] %>

<%= render "machines/head", machine: @machine, status: nil %>
<div class="label-row"><%= render "labels/editor", labelable: @machine %></div>

<%# Everything that needs the box loads here, after the page is already on screen. The
    placeholder says what is happening in the words it is happening in: the command
    being run, and a cursor. %>
<%= turbo_frame_tag "machine-live", src: live_machine_path(@machine, q: @q.presence), target: "_top" do %>
  <div class="reading-box" role="status">
    <p class="reading-line"><span class="reading-prompt">$</span> steward status --json<span class="reading-cursor" aria-hidden="true"></span></p>
    <p class="muted">Reading <%= @machine.name %> over scoped SSH…</p>
  </div>
<% end %>

<%# ── Machine settings ────────────────────────────────────────────────────────
    A different section entirely, and behind a click. Ownership, the key, and removal
    configure the box — they do not report on it — and they were taking the top of
    the page. Collapsed by default so that changing anything is a thing you chose to
    do, the same rule the destructive controls inside already follow. %>
<details class="page-settings">
  <summary>
    <%= icon "chevron-down", size: 16, css_class: "icon settings-caret" %>
    <%= icon "settings", size: 16 %>
    <span>Machine Settings</span>
    <span class="muted">ownership, sharing, the key, and removal</span>
  </summary>

  <%= render "machines/sharing", machine: @machine, projects: @projects %>

  <%# Steward's scoped key for this box, and the line to authorize it. Steward generates
      the key (private encrypted); the operator runs this on the box once to let it in.
      See machine-onboarding.md / Access (#16). %>
  <% if @machine.authorize_command %>
    <details class="access" <%= "open" if @machine.never_reached? %>>
      <summary><%= icon "shield", size: 13 %> Steward’s key · authorize on the box</summary>
      <p class="note">Run this once on the box (as the operator) to let Steward in:</p>
      <%= command_block(@machine.authorize_command) %>
      <p class="note muted">Steward holds the matching private key (encrypted) and never root.</p>
    </details>
  <% end %>

  <%# Remove — forget this box in the control plane. The box keeps running; this only
      deletes Steward's record of it. An honest confirm, no blocking. %>
  <% remove_note = "Remove #{@machine.name} from Steward?\n\n" \
                   "The box keeps running — this only forgets it here, and Steward’s key " \
                   "stays authorized until you revoke it on the box." %>
  <% remove_note += "\n\n#{pluralize(@apps.size, 'app')} deployed here will lose their deployment record." if @apps.any? %>
  <div class="panel danger-remove">
    <h3 class="danger-head"><%= icon "trash-2", size: 15 %> Remove this Machine</h3>
    <p class="note">This only forgets <strong><%= @machine.name %></strong> in Steward — the box
      keeps running, and Steward’s key stays authorized until you revoke it on the box:</p>
    <%= command_block(@machine.revoke_command) %>
    <% if @apps.any? %>
      <p class="note muted"><%= pluralize(@apps.size, "app") %> deployed here
        (<%= @apps.map(&:name).join(", ") %>) will lose their deployment record.</p>
    <% end %>
    <%= button_to safe_join([ icon("trash-2", size: 14), %(Remove "#{@machine.name}") ]),
          machine_path(@machine), method: :delete, class: "btn danger",
          data: { turbo_confirm: remove_note } %>
  </div>
</details>
