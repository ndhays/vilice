<% content_for :title, "#{@machine.name} — Steward" %>

<%= breadcrumb [["Machines", machines_path], [@machine.name, nil]] %>

<%# ── Identity: the name and its one live state, then what the box *is* ────────
    Online is the only pill: the one fact here that changes under you, read live on
    this request. What the box is reads as a short labelled list, labels in one
    column and values in the next, so every page puts each fact in the same place.
    Access is not listed — the Operate zone says it, where it matters. %>
<h1 class="machine-head">
  <%# On the box Steward runs on, lead with a location pin — "you are here" at a
      glance, said in words on hover. Otherwise the glyph is the role. %>
  <% if you_are_here?(@status) %>
    <%# NOTE: acting on the self box is the OOM-sensitive path (Steward deploying its
        own box) — the mutate ceremony will need self-aware handling here (warn/guard)
        before #20 self-deploy. See decisions/open/ui-shape.md. %>
    <%= icon_tip "map-pin", "You are here — the box Steward runs on", size: 22 %>
  <% else %>
    <%= icon machine_role_icon_name(@machine, @status), size: 22 %>
  <% end %>
  <span class="machine-name"><%= @machine.name %></span>
  <%# Health, beside the name: a dot and plain words — "Online", or what is wrong. %>
  <%= health_line(@status) %>
</h1>

<dl class="facts">
  <dt>Address</dt><dd class="mono"><%= ssh_address(@machine) %></dd>
  <dt>Role</dt><dd><%= machine_role_word(@machine, @status) %></dd>
  <dt>Owner</dt><dd><%= @machine.owner ? link_to(@machine.owner.name, @machine.owner) : tag.span("none", class: "fact-gap", title: "Transfer to an owner to use machine") %></dd>
  <dt>Sharing</dt><dd><%= sharing_mode_label(@machine.sharing) %></dd>
  <%# The name mirrors the box (decisions/machine-name-mirrors-the-box.md), so the name
      the box reports is only news when the two differ. %>
  <% if @status.online? && @status.hostname.present? && @status.hostname != @machine.name %>
    <dt>Box says</dt><dd class="mono" title="The hostname the box reports; the name here has not caught up"><%= @status.hostname %></dd>
  <% end %>
  <% if (clients = @machine.projects.where.not(id: @machine.owner_id)).any? %>
    <dt>Also serves</dt><dd><%= safe_join(clients.map { |p| link_to(p.name, p) }, ", ") %></dd>
  <% end %>
</dl>
<div class="label-row"><%= render "labels/editor", labelable: @machine %></div>

<%# ── Two zones, side by side ─────────────────────────────────────────────────
    Observe on the left: what the box reports. Nothing in it writes — at most it
    points across. Operate on the right: every act this box can take, each with
    the exact command it sends, and the ceremony opens there too. So a reader never
    has to work out which kind of control they are looking at: it is where it sits. %>
<div class="zones">
<section class="zone zone-observe" aria-label="Observe">
  <h2 class="zone-head"><%= icon "eye", size: 15 %> Observe</h2>

<%# When the box does not answer we know **nothing current** about it, so the zone
    does not lay out empty cards that each apologise in their own words. One card
    owns the message. Our own record stays at full strength further down. %>
<% if !@status.online? %>
  <div class="panel unreachable">
    <div class="panel-head">
      <div class="kicker">Unreachable</div>
      <%= button_to refresh_machine_path(@machine), class: "btn cmd observe sm panel-action", title: "Read the box again" do %>
        <%= steward_verb "status" %>
      <% end %>
    </div>
    <p class="unreachable-line">
      <%= icon "circle-cut", size: 18 %>
      Steward could not reach <strong><%= @machine.name %></strong><%
        %><% if @machine.last_seen_at %>, last heard from <%= time_ago_in_words(@machine.last_seen_at) %> ago<% end %>.
    </p>
    <pre class="raw"><%= @status.error %></pre>
  </div>
<% else %>
  <div class="panel observe">
    <div class="panel-head">
      <div>
        <div class="kicker">Live status</div>
        <p class="read-age"><%= read_age(@status) %></p>
      </div>
      <%# A POST, not a link: it opens an SSH connection to the box, so it must not be
          something a hover or a prefetch can fire. A read, so it lives on this side. %>
      <%= button_to refresh_machine_path(@machine), class: "btn cmd observe sm panel-action", title: "Read the box again" do %>
        <%= steward_verb "status" %>
      <% end %>
    </div>

    <ul class="metrics">
      <li><span class="k"><%= icon "cpu", size: 13 %> load</span><span class="v"><%= @status.load1 %></span></li>
      <li><span class="k"><%= icon "memory-stick", size: 13 %> memory used</span><span class="v"><%= @status.mem_percent %>%</span></li>
      <li><span class="k"><%= icon "container", size: 13 %> disk used</span><span class="v"><%= @status.disk_percent %>%</span></li>
      <li><span class="k"><%= icon "clock", size: 13 %> uptime</span><span class="v"><%= distance_of_time_in_words(0, @status.uptime_sec) %></span></li>
    </ul>
    <%# Hardening posture, read from the fact the box published (not a live check). %>
    <%= hardening_line(@status) %>
    <%# What the cards above are read from: the command, then exactly what it returned. %>
    <details class="raw-output">
      <summary>Raw status output</summary>
      <p class="raw-cmd">steward status --json</p>
      <pre class="raw"><%= JSON.pretty_generate(@status.raw) %></pre>
    </details>
  </div>

  <%# Maintenance — when the box patches itself, and whether anything is waiting.
      Pure observe now: applying lives across in Operate. %>
  <div class="panel observe">
    <div class="kicker">Maintenance</div>
    <% if @status.maintenance_known? %>
      <p class="maint-line"><%= icon "stethoscope", size: 15 %>
        <strong>Daily at <%= @status.maintenance_time %></strong></p>
      <p class="muted maint-note">Security patches install themselves<%=
        "; the box reboots then if the kernel needs it" if @status.auto_reboot? %>.</p>
    <% else %>
      <p class="maint-line muted"><%= icon "stethoscope", size: 15 %>
        <strong>No maintenance window.</strong></p>
      <p class="muted maint-note">Updates wait until someone applies them.</p>
    <% end %>
    <% if @status.updates_available? %>
      <p class="maint-pending" title="<%= @status.update_packages.join("\n") %>">
        <%= icon "circle-dot", size: 15 %>
        <strong><%= pluralize(@status.update_count, "update") %> waiting</strong>
      </p>
      <% if @status.update_packages.any? %>
        <p class="muted maint-note mono"><%= @status.update_packages.join(" ") %></p>
      <% end %>
    <% else %>
      <p class="muted updates-current"><%= icon "circle-check", size: 15 %> <strong>Up to date.</strong></p>
    <% end %>
  </div>

  <%# ── Apps ──────────────────────────────────────────────────────────────────
      What the box says is running, which is the reason the box exists. Each row
      carries the image digest it is actually running and links through to the
      Install where we have one. Absent only where the box says it is a balancer. %>
  <% unless @status.balancer? %>
    <div class="panel observe">
      <div class="kicker">Apps on this box</div>
      <% if @status.apps.empty? %>
        <p class="muted">No apps on this box.</p>
      <% else %>
        <ul class="rows app-box-rows">
          <% @status.apps.each do |app| %>
            <% install = @installs.find { |i| i.name == app["name"] } %>
            <li class="row">
              <span class="cell-name">
                <%= icon "box", size: 15, css_class: "icon row-icon" %>
                <% if install %>
                  <%= link_to app["name"], install, class: "row-name" %>
                <% else %>
                  <span class="row-name"><%= app["name"] %></span>
                <% end %>
              </span>
              <span class="cell-project">
                <% if install&.project %>
                  <%= link_to install.project.name, install.project, class: "owner-link" %>
                <% elsif install.nil? %>
                  <%# The box runs it, our record doesn't know it — a machine-view deploy
                      keeps no Install, and so does anything deployed outside the console. %>
                  <span class="badge unowned" title="Running on the box with no placement recorded here">not in our record</span>
                <% end %>
              </span>
              <span class="cell-image"><%= digest_chip(app["image"]) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <%# Placements we hold that the box did not report back. The gap is stated, never
          closed on its own (decisions/drift-is-surfaced-never-closed.md). %>
      <% missing = @installs.reject { |i| @status.apps.any? { |a| a["name"] == i.name } } %>
      <% if missing.any? %>
        <p class="note muted">
          <%= icon "triangle-alert", size: 13 %>
          Placed here but not reported running:
          <%= safe_join(missing.map { |i| link_to(i.name, i) }, ", ") %>.
        </p>
      <% end %>
    </div>
  <% end %>

  <%# ── The edge, when this box is a balancer ───────────────────────────────
      Two halves, kept visibly apart: the table this box *should* serve, derived from
      the installs that select it, and the addresses it *reports* fronting. Nothing
      reconciles them — applying is an act, across in Operate. %>
  <% if @machine.balancer? %>
    <div class="panel observe">
      <div class="kicker">Edge · derived from the apps behind it</div>
      <% if @table.any? %>
        <ul class="route-table">
          <% @table.each do |r| %>
            <li>
              <span class="route-host mono"><%= r.hostnames.join(" ") %></span>
              <span class="route-arrow">→</span>
              <span class="route-ups mono"><%= r.upstreams.join(", ") %></span>
              <%= link_to r.install.name, r.install, class: "route-install" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="note muted">No app selects this balancer yet, so the table is empty.</p>
      <% end %>
      <p class="note muted">
        <% if @status.routes.any? %>
          Box reports fronting: <span class="mono"><%= @status.routes.join(", ") %></span>
        <% else %>
          Box reports fronting nothing yet.
        <% end %>
      </p>
    </div>
  <% end %>
<% end %>
</section>

<section class="zone zone-operate" aria-label="Operate">
  <h2 class="zone-head"><%= icon "zap", size: 15 %> Operate</h2>
  <%= render "machines/operate", machine: @machine, status: @status, table: @table %>
  <%# The ceremony lands here, inside the zone that writes: pick an act → this frame
      fills with the preview of the exact record line, then Confirm writes & runs it. %>
  <%= turbo_frame_tag "ceremony" %>
</section>
</div>

<%# ── Record — this box's half of the two records, newest first ─────────────── %>
<h2 class="section-kicker"><%= icon "disc", size: 15 %> Record</h2>
<%= record_integrity(@record) %>
<%# The chain is assembled from two sources — our own events and the box's — so the
    search filters the assembled list rather than a relation. A plain GET, so a
    narrowed record stays a link you can send. %>
<%= form_with url: machine_path(@machine), method: :get, class: "filter-bar" do |f| %>
  <span class="filter-search">
    <%= icon "search", size: 15 %>
    <%= f.search_field :q, value: @q, autocomplete: "off", spellcheck: false,
          placeholder: "Search this box's record" %>
  </span>
  <%= f.submit "Search", class: "btn sm" %>
  <% if @q.present? %>
    <%= link_to "Clear", machine_path(@machine), class: "filter-clear" %>
  <% end %>
<% end %>
<% if @chain.empty? && @q.present? %>
  <p class="empty">Nothing in this box's record matches. <%= link_to "Clear it", machine_path(@machine) %>.</p>
<% else %>
  <%= render "events/chain", items: @chain, within: @machine %>
<% end %>

<%# ── Machine settings ────────────────────────────────────────────────────────
    A different section entirely, and behind a click. Ownership, the key, and removal
    configure the box — they do not report on it — and they were taking the top of
    the page. Collapsed by default so that changing anything is a thing you chose to
    do, the same rule the destructive controls inside already follow. %>
<details class="page-settings">
  <summary>
    <%= icon "chevron-down", size: 16, css_class: "icon settings-caret" %>
    <%= icon "settings", size: 16 %>
    <span>Machine Settings</span>
    <span class="muted">ownership, sharing, the key, and removal</span>
  </summary>

  <%= render "machines/sharing", machine: @machine, projects: @projects %>

  <%# Steward's scoped key for this box, and the line to authorize it. Steward generates
      the key (private encrypted); the operator runs this on the box once to let it in.
      See machine-onboarding.md / Access (#16). %>
  <% if @machine.authorize_command %>
    <details class="access" <%= "open" unless @status.online? %>>
      <summary><%= icon "shield", size: 13 %> Steward’s key · authorize on the box</summary>
      <p class="note">Run this once on the box (as the operator) to let Steward in:</p>
      <%= command_block(@machine.authorize_command) %>
      <p class="note muted">Steward holds the matching private key (encrypted) and never root.</p>
    </details>
  <% end %>

  <%# Remove — forget this box in the control plane. The box keeps running; this only
      deletes Steward's record of it. An honest confirm, no blocking. %>
  <% remove_note = "Remove #{@machine.name} from Steward?\n\n" \
                   "The box keeps running — this only forgets it here, and Steward’s key " \
                   "stays authorized until you revoke it on the box." %>
  <% remove_note += "\n\n#{pluralize(@installs.size, 'app')} deployed here will lose their deployment record." if @installs.any? %>
  <div class="panel danger-remove">
    <h3 class="danger-head"><%= icon "trash-2", size: 15 %> Remove this Machine</h3>
    <p class="note">This only forgets <strong><%= @machine.name %></strong> in Steward — the box
      keeps running, and Steward’s key stays authorized until you revoke it on the box:</p>
    <%= command_block(@machine.revoke_command) %>
    <% if @installs.any? %>
      <p class="note muted"><%= pluralize(@installs.size, "app") %> deployed here
        (<%= @installs.map(&:name).join(", ") %>) will lose their deployment record.</p>
    <% end %>
    <%= button_to safe_join([ icon("trash-2", size: 14), %(Remove "#{@machine.name}") ]),
          machine_path(@machine), method: :delete, class: "btn danger",
          data: { turbo_confirm: remove_note } %>
  </div>
</details>
