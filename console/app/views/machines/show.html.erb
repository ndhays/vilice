<% content_for :title, "#{@machine.name} — Vilice" %>

<%= breadcrumb [["Machines", machines_path], [@machine.name, nil]] %>

<%= render "machines/head", machine: @machine, status: nil %>
<div class="label-row with-action">
  <%= render "labels/editor", labelable: @machine %>
  <%# What configures the box rather than reports on it lives on its own page
      (decisions/machine-settings-is-a-page.md). %>
  <%= link_to safe_join([ icon("settings", size: 15), "Settings" ]), settings_machine_path(@machine), class: "btn sm" %>
</div>

<%# A box Vilice has never reached is waiting on one thing: the authorize line, run on
    the box. So until the first read lands, that line leads the page instead of
    sitting in Settings — the next step goes where you will look for it. %>
<% if @machine.never_reached? && @machine.authorize_command %>
  <div class="panel connect">
    <h2 class="connect-head"><%= icon "key-round", size: 16 %> Connect <%= @machine.name %></h2>
    <p class="note">Vilice has not reached this box yet. Run this once on the box, from an
      account that can <code>sudo</code>, to let Vilice in at <strong><%= @machine.scope %></strong> scope:</p>
    <%= command_block(@machine.authorize_command) %>
    <div class="connect-foot">
      <p class="note muted">Vilice holds the matching private key, encrypted, and never root.
        Then read the box:</p>
      <%= button_to refresh_machine_path(@machine), class: "btn cmd observe sm", title: "Read the box" do %>
        <%= vilice_verb "status" %>
      <% end %>
    </div>
  </div>
<% end %>

<%# Everything that needs the box loads here, after the page is already on screen. The
    placeholder says what is happening in the words it is happening in: the command
    being run, and a cursor. %>
<%= turbo_frame_tag "machine-live", src: live_machine_path(@machine, q: @q.presence), target: "_top" do %>
  <div class="reading-box" role="status">
    <p class="reading-line"><span class="reading-prompt">$</span> vilice status --json<span class="reading-cursor" aria-hidden="true"></span></p>
    <p class="muted">Reading <%= @machine.name %> over scoped SSH…</p>
  </div>
<% end %>
