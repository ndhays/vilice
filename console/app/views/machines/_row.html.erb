<%# One machine as a compact list row, reused by the fleet list and the project
    page (owned + shared sections). Calm: a reachability glyph leads (exceptions
    rise in colour), then a compact scope glyph + name, the labels you group by,
    the owning project, and when we last heard from it. Everything else (host,
    metrics, full sharing/access) is a click in on the name. `show_owner: false`
    drops the owner column where it'd just repeat the page's own project. %>
<% show_owner = local_assigns.fetch(:show_owner, true) %>
<li class="row<%= " is-self" if local_machine?(machine) %>">
  <span class="cell-name">
    <span class="row-icon"><%= icon "hard-drive", size: 15 %></span>
    <%= machine_status_icon(machine) %>
    <%= link_to machine.name, machine, class: "row-name" %>
    <% if local_machine?(machine) %>
      <span class="self-pin" title="this Steward Console instance's actual running machine"><%= icon "map-pin", size: 15 %></span>
    <% end %>
  </span>
  <span class="cell-labels"><%= compact_label_badges(machine) %></span>
  <%# Always render the cell so the subgrid columns line up; empty when suppressed. %>
  <span class="cell-owner">
    <% if show_owner %>
      <% if machine.owner %>
        <%= link_to machine.owner.name, machine.owner, class: "owner-link" %>
      <% else %>
        <%= owner_badge(machine) %>
      <% end %>
    <% end %>
  </span>
  <span class="cell-seen"><%= machine.last_seen_at ? "seen #{time_ago_in_words(machine.last_seen_at)} ago" : "—" %></span>
  <span class="cell-scope"><%= scope_icon(machine) %></span>
</li>
