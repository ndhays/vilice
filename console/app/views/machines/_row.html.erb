<%# One machine as a compact list row, reused by the fleet list and the project
    page (owned + shared sections). Calm: a reachability glyph leads (exceptions
    rise in colour), then a compact scope glyph + name, the labels you group by,
    the owning project, and when we last heard from it. Everything else (host,
    metrics, full sharing/access) is a click in on the name. `show_owner: false`
    drops the owner column where it'd just repeat the page's own project. %>
<% show_owner = local_assigns.fetch(:show_owner, true) %>
<%# In a fleet group the balancer heads the list and the boxes it fronts are drawn
    beneath it, so the row says which side of the edge it is on. %>
<% in_tree = local_assigns[:fleet] && !machine.balancer? %>
<li class="row<%= " is-self" if local_machine?(machine) %><%= " is-behind" if in_tree %><%
    %><%= " is-edge" if local_assigns[:fleet] && machine.balancer? %>">
  <%# Reachability leads — it is the one thing you scan a fleet for. What the box is
      *for* trails on the right beside the scope marker, where the quiet markers live. %>
  <span class="cell-name">
    <%= machine_status_icon(machine) %>
    <%= link_to machine.name, machine, class: "row-name" %>
    <% if local_machine?(machine) %>
      <%= icon_tip "map-pin", "This box — the machine Steward runs on",
            size: 15, css_class: "self-pin" %>
    <% end %>
    <%# Which edge fronts this box. A fact about this one row, so it holds under every
        grouping — where the Fleet tree, which draws a relationship *between* rows, only
        holds when the group is that fleet. Dropped there, because the indent says it. %>
    <% unless in_tree %>
      <% edges = machine.behind %>
      <% if edges.any? %>
        <span class="behind-edge">behind <%= safe_join(edges.map { |e| link_to(e.name, e) }, ", ") %></span>
      <% end %>
    <% end %>
  </span>
  <span class="cell-labels"><%= compact_label_badges(machine) %></span>
  <%# Always render the cell so the subgrid columns line up; empty when suppressed. %>
  <span class="cell-owner">
    <% if show_owner %>
      <% if machine.owner %>
        <%= link_to machine.owner.name, machine.owner, class: "owner-link" %>
      <% else %>
        <%= owner_badge(machine) %>
      <% end %>
    <% end %>
  </span>
  <span class="cell-seen"><%= machine.last_seen_at ? "seen #{time_ago_in_words(machine.last_seen_at)} ago" : "—" %></span>
  <span class="cell-role"><%= role_icon(machine) %></span>
  <span class="cell-scope"><%= scope_icon(machine) %></span>
</li>
