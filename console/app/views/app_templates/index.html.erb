<% content_for :title, "App Library — Vilice" %>

<%= page_header "App Library", icon: "library-big" do %>
  <%= button_link_to "Add Template", new_app_template_path, icon: "plus", class: "btn sm" %>

  <span class="head-divider" aria-hidden="true"></span>

  <%# Import — a small menu, since a manifest can come from a file or a URL (the
      marketplace path). Degrades to two plain forms with no JS. %>
  <details class="menu">
    <summary class="btn sm"><%= safe_join([ icon("file-up", size: 14), "Import Library" ]) %></summary>
    <div class="menu-pop">
      <%= form_with url: import_app_templates_path, method: :post, html: { multipart: true }, class: "menu-form" do |f| %>
        <span class="menu-label">From a file</span>
        <%= f.file_field :file, accept: ".yml,.yaml", required: true %>
        <%= f.submit "Import file", class: "btn-quiet" %>
      <% end %>
      <div class="menu-rule"></div>
      <%= form_with url: import_app_templates_path, method: :post, class: "menu-form" do |f| %>
        <span class="menu-label">From a URL</span>
        <%= f.url_field :url, placeholder: "https://applibrary.agoraforge.org/…", required: true %>
        <%= f.submit "Import URL", class: "btn-quiet" %>
      <% end %>
    </div>
  </details>

  <% if AppTemplate.exists? %>
    <%= button_link_to "Export Library", export_app_templates_path, icon: "file-down", class: "btn sm" %>
  <% end %>
<% end %>

<% if @app_templates.any? || @q.present? %>
  <div class="list-managed" data-controller="selection">
    <%= render layout: "shared/list_toolbar",
          locals: { search_url: app_templates_path, q: @q, placeholder: "name  ·  key=value label" } do %>
      <%= button_tag type: "submit", form: "apps-bulk", class: "btn-quiet danger",
            formnovalidate: true, disabled: true, data: { selection_target: "action" } do %>
        <%= safe_join([ icon("trash-2", size: 14), "Remove" ]) %>
      <% end %>
    <% end %>

    <% if @app_templates.any? %>
      <%= form_with url: remove_selected_app_templates_path, method: :delete, id: "apps-bulk",
            data: { turbo_confirm: "Remove the selected templates from the App Library?" } do %>
        <ul class="rows template-rows">
          <%= render partial: "app_templates/row", collection: @app_templates, as: :app %>
        </ul>
      <% end %>
    <% else %>
      <p class="empty">No templates match this search.</p>
    <% end %>
  </div>
<% else %>
  <p class="empty">No templates yet. <%= link_to "Add one", new_app_template_path %>, or import from
    <a href="https://applibrary.agoraforge.org">a shared library</a>.</p>
<% end %>
