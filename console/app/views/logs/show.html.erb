<%# A log tail, as it came off the box. Rendered into the app page's `logs` frame.

    Framed as a plain panel, never the mutate one: this is a read, and the violet zone
    means "this will be recorded". Nothing here is. %>
<%= turbo_frame_tag "logs" do %>
  <div class="panel logs-panel">
    <div class="panel-head">
      <div class="kicker">Logs · <%= @app.name %> on <%= @machine.name %></div>
      <span class="panel-action logs-controls">
        <%# The tail is the whole control surface. `podman logs` is a passthrough, so
            these are the box's own lines and there is nothing to filter here that
            `grep` would not do better on the far side. %>
        <% Vilice::Observe::TAILS.each do |n| %>
          <%= link_to n, machine_logs_path(@machine, app_id: @app.id, tail: n),
                class: "logs-tail#{' on' if n == @tail}",
                data: { turbo_frame: "logs" }, title: "Last #{n} lines" %>
        <% end %>
        <%= link_to safe_join([ icon("rotate-cw", size: 13), "Refresh" ]),
              machine_logs_path(@machine, app_id: @app.id, tail: @tail),
              class: "btn-quiet sm", data: { turbo_frame: "logs" } %>
        <%= link_to "Close", app_path(@app),
              class: "btn-quiet sm", data: { turbo_frame: "logs" } %>
      </span>
    </div>

    <% if @result[:ok] %>
      <% body = @result.dig(:data, "message").to_s %>
      <% if body.strip.empty? %>
        <p class="empty">The container has written nothing yet.</p>
      <% else %>
        <pre class="logs-body"><%= body %></pre>
      <% end %>
      <p class="note muted">Last <%= @tail %> lines, read just now — nothing is cached and
        nothing was recorded. The container is the source of truth; Vilice stores no copy.</p>
    <% else %>
      <%# The box's own sentence, not our transport's. `Vilice.read` unwraps the
          `Result` message, so "no running app" arrives as those words. %>
      <p class="empty"><%= icon "circle-x", size: 14 %> <%= @result[:error] %></p>
      <% if @result[:reached] == false %>
        <p class="note muted"><%= @machine.connection_hint %></p>
      <% end %>
    <% end %>
  </div>
<% end %>
