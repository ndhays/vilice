<% content_for :title, "Sign In — Steward" %>

<div class="auth">
  <div class="auth-card">
    <%= render "shared/auth_brand" %>

    <%= form_with url: session_path, class: "stack-form" do |form| %>
      <label class="field"><span>Email</span>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username", value: params[:email_address],
              placeholder: "you@example.com" %></label>
      <label class="field"><span>Password</span>
        <%= form.password_field :password, required: true, maxlength: 72,
              autocomplete: "current-password", placeholder: "••••••••" %></label>

      <%# No icon: the word is the whole button, and a glyph beside "Sign In" says
          nothing the word doesn't. Amber is reserved for a recorded act against a
          box (blueprint/design/tokens.md), so this is the plain ink button. %>
      <%= button_tag "Sign In", class: "btn auth-submit" %>
      <%= link_to "Forgot password?", new_password_path, class: "auth-link" %>
    <% end %>
  </div>
</div>
