<%# A project is optional context, and it comes from the URL — never a dropdown here
    (blueprint/console/journeys.md). With one, the crumb trail and the machine list
    stay inside that client; without one, this is plain fleet-wide placement and
    nothing asks you to invent a client first (decisions/console-layers.md). %>
<%# One name for one thing. The list's button, the crumb, this heading and the submit all
    read **Add Install**, and the act is `added install` — it had four names between them.
    The project rides the crumb, not the heading, the same way Add Machine leaves its owner
    to the Owner step instead of restating it up top. %>
<% content_for :title, [ "Add App", @project&.name, "Steward" ].compact.join(" — ") %>

<% if @project %>
  <%= breadcrumb [ [ "Projects", projects_path ], [ @project.name, project_path(@project) ], [ "Add App", nil ] ] %>
<% else %>
  <%= breadcrumb [ [ "Apps", installs_path ], [ "Add App", nil ] ] %>
<% end %>
<h1>Add App</h1>

<p class="addr">What should run, and how much of it. <strong>Nothing is deployed by
  filling this in</strong> — a box is optional here, and putting the app on one is a
  separate, witnessed act.</p>

<%= form_with url: installs_path(project_id: @project&.id), scope: :install, method: :post,
      class: "stack-form install-form", data: { controller: "install-form" } do |f| %>
  <% if @install.errors.any? %>
    <div class="flash alert"><%= @install.errors.full_messages.to_sentence %></div>
  <% end %>

  <%# One primitive: "single vs fleet" is just a count (decisions/one-primitive-composed.md).
      The legend used to read "Machine Configuration", which was jargon for a plain idea and
      had also stopped being true — no machine is configured here, and the box moved to its
      own step. The two cards carry no hint: the words are the whole choice.
      The reveal is pure CSS (:has) — no JS, degrades to all-visible. %>
  <fieldset class="step placement">
    <legend>Scale <%= hint "How many boxes should serve this app. One box is the default; more than one needs a balancer in front, because on the edge DNS points at a single box." %></legend>
    <div class="radio-cards plain">
      <div class="radio-row">
        <label class="radio">
          <input type="radio" name="placement" value="single" checked>
          <%= icon "hard-drive", size: 22 %>
          <span class="radio-label">Single machine</span>
        </label>
        <label class="radio">
          <input type="radio" name="placement" value="fleet">
          <%= icon "hard-drives", size: 22 %>
          <span class="radio-label">Fleet</span>
        </label>
      </div>
    </div>

    <%# Fleet: a count only means something if the app is reached somewhere other than
        one box's own address, so exposure is asked first and gates it
        (decisions/one-primitive-composed.md). %>
    <div class="fleet-only">
      <%= render "installs/exposure_fields", f: f, install: @install %>
    </div>
  </fieldset>

  <%# **Optional, in both branches.** An install is an intention and an intention does
      not need a box (decisions/drift-is-surfaced-never-closed.md) — leaving this blank
      states what should run and opens the gap, which is a complete answer. It is also
      what lets Fleet submit at all: there is no "first box" problem once no box is
      required. Provisioning one from here stays an open question
      (decisions/open/create-machine.md). %>
  <fieldset class="step">
    <legend>First box <%= hint "Optional. Leave it blank to state the intention now and place it on a box later — placing is its own recorded act either way." %></legend>
    <% if @machines.any? %>
      <label class="field">
        <%= f.collection_select :machine_id, @machines, :id, :machine_option_label,
              { include_blank: "None yet — place it later" }, {} %>
        <%# The authorize gap, said before the choice rather than after the failure: a box
            we have never reached has not run its authorize line yet, and a deploy aimed
            at it cannot connect (decisions/open/what-could-go-wrong.md). %>
        <% if @machines.any?(&:never_reached?) %>
          <small class="muted">Boxes marked <em>not yet authorized</em> have never
            answered us — run the authorize line shown on the box's own page before
            deploying to one.</small>
        <% end %>
      </label>
    <% elsif @project %>
      <p class="muted">No machines on this project yet —
        <%= link_to "add one", new_machine_path(project_id: @project.id) %>, or leave this
        app unplaced for now.</p>
    <% else %>
      <p class="muted">No boxes carry an operate key yet —
        <%= link_to "add a machine", new_machine_path %>, or leave this app unplaced
        for now.</p>
    <% end %>
  </fieldset>

  <fieldset class="step">
    <legend>Template</legend>
    <% if @app_templates.any? %>
      <div class="pick-card">
        <input type="search" class="pick-search" placeholder="Search templates…" autocomplete="off"
               aria-label="Search templates"
               data-install-form-target="search" data-action="input->install-form#filter">
        <div class="pick-list">
          <% @app_templates.each do |app| %>
            <label class="pick-option">
              <%= f.radio_button :app_template_id, app.id,
                    data: { action: "install-form#pickApp",
                            versions: app.versions.newest_first.map { |v| { id: v.id, tag: v.tag, latest: v.latest } }.to_json,
                            name: app.name, port: app.port, health: app.health } %>
              <span class="row-icon"><%= icon "box", size: 15 %></span>
              <span class="row-name"><%= app.name %></span>
              <% if (v = app.latest_version) %>
                <span class="mono"><%= v.tag %></span><span class="tag latest">latest</span>
              <% end %>
              <%= label_badges(app) %>
            </label>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="muted">No installable apps — <%= link_to "add a version to a library app", app_templates_path %> first.</p>
    <% end %>

    <% if @allow_custom %>
      <label class="pick-option pick-custom">
        <%= f.radio_button :app_template_id, "", checked: false,
              data: { action: "install-form#pickApp", custom: "true" } %>
        <span class="row-icon"><%= icon "box", size: 15 %></span>
        <span class="row-name">Custom image</span>
        <span class="muted">enter an image below</span>
      </label>
    <% end %>

    <%# "App Version" under a legend that already says AppTemplate. %>
    <label class="field" data-install-form-target="versionField">
      <span>Version</span>
      <%= f.select :version_id, [], {}, data: { install_form_target: "version" } %>
    </label>

    <% if @allow_custom %>
      <label class="field" data-install-form-target="imageField">
        <span>Custom image <%= hint "A digest-pinned container image, e.g. ghcr.io/acme/web@sha256:…" %></span>
        <%= f.text_field :image, value: @install.image, class: "mono", autocomplete: "off",
              spellcheck: false, placeholder: "ghcr.io/acme/web@sha256:…" %>
      </label>
    <% end %>
  </fieldset>

  <div data-install-form-target="rest">
    <fieldset class="step">
      <legend>Hostname <%= hint "The public domain where the app will be served, e.g. app.example.com." %></legend>
      <label class="field">
        <%= f.text_field :hostname, value: @install.hostname, class: "mono",
              autocomplete: "off", placeholder: "app.example.com" %>
        <small class="muted">Where the app will be served. (DNS is checked before deployment.)</small>
      </label>
    </fieldset>

    <%# "Details" said nothing. These three are the app's own facts, arriving prefilled and
        overridable for this one install — so the legend says whose they are. %>
    <fieldset class="step">
      <legend>Template defaults</legend>
      <p class="form-note muted">Prefilled from the template — change any to override them for this app.</p>
      <label class="field"><span>Name on the box <%= hint "What this app is called on the machine — its unit, its volumes, its apps/<name>.json. Letters, digits, dashes and underscores." %></span>
        <%= f.text_field :name, value: @install.name, data: { install_form_target: "name" },
              autocomplete: "off", pattern: "[A-Za-z0-9_-]+",
              title: "Letters, digits, dashes, and underscores — the app's name on the box" %></label>
      <div class="field-row">
        <label class="field">
          <span>Port <%= hint "The port the app listens on inside its container." %></span>
          <%= f.number_field :port, value: @install.port, data: { install_form_target: "port" },
                min: 1024, max: 65535 %>
        </label>
        <label class="field">
          <span>Health <%= hint "A path that returns 200 when the app is healthy (e.g. /up). The deploy waits for it before going live." %></span>
          <%= f.text_field :health, value: @install.health, class: "mono",
                data: { install_form_target: "health" }, placeholder: "/up", pattern: "/.*",
                title: "A path starting with /" %>
        </label>
      </div>
    </fieldset>

    <fieldset class="step">
      <legend>Storage <%= hint "Named volumes that survive every redeploy — the box keeps the data on disk while the code is replaced." %></legend>
      <label class="field">
        <%= f.text_area :volumes, value: @install.volumes.join("\n"), rows: 2, class: "mono",
              autocomplete: "off", spellcheck: false, placeholder: "storage:/rails/storage" %>
        <small class="muted">Optional. One <span class="mono">name:/path/in/container</span> per line — data that outlives deploys (a database, uploads). Leave blank for a stateless app.</small>
      </label>
    </fieldset>

    <div class="form-actions">
      <%# The act is `added install`, and it reaches no box: this writes an intention.
          It used to promise "and Deploy", which was only true when a box happened to be
          picked, and blurred the one line that matters — setup is control-plane, the
          deploy is a witnessed ceremony of its own. Pick a box and that ceremony is the
          next screen; it still asks. `added` draws a plus, so the button does too. %>
      <%= button_tag class: "btn mutate" do %>
        <%= safe_join([ icon("plus", size: 14), "Add App" ]) %>
      <% end %>
      <%= button_link_to "Cancel", @project ? project_path(@project) : installs_path, class: "btn-quiet" %>
    </div>
  </div>
<% end %>
