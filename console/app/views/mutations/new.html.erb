<%# Preview the record entry — the confirm step IS the record-before-act
    invariant made visible. Nothing is written until Confirm. The line below is
    rendered with the same chain styling it will have once committed. %>
<%= turbo_frame_tag "ceremony" do %>
  <div class="ceremony">
    <div class="kicker">Confirm · this writes to the record</div>
    <p class="ceremony-intro">You're about to witness this act on
      <strong><%= @machine.name %></strong>. It will be recorded, then run:</p>

    <%= render "events/chain", items: [ @mutation.preview_item ] %>

    <%# For deploy, show the resolved desired state the box will converge to. %>
    <% if @mutation.needs_compose? %>
      <dl class="spec">
        <div><dt>image</dt><dd class="mono"><%= @mutation.image %></dd></div>
        <div><dt>hostname</dt><dd class="mono"><%= @mutation.hostname.presence || "—" %></dd></div>
        <div><dt>port</dt><dd class="mono"><%= @mutation.port || "—" %></dd></div>
        <div><dt>health</dt><dd class="mono"><%= @mutation.health.presence || "/" %></dd></div>
        <%# The release command runs on the box, with this app's secrets, before anything
            starts — so it is shown before the press that authorizes it, not discovered in
            the record afterwards. That is the confirm step's actual job. %>
        <% if (release = @mutation.install&.release).present? %>
          <div><dt>release</dt><dd class="mono"><%= release.join(" ") %></dd></div>
        <% end %>
      </dl>
      <% if release.present? %>
        <p class="note">Runs first, from the new image. If it fails, nothing is deployed
          and <%= @mutation.install.name %> keeps serving what it serves now.</p>
      <% end %>
      <%# Accessories come up before anything else, hold data, and are reachable by this
          app alone. Worth seeing before the press for the same reason the release command
          is: they are containers this act starts on the box. %>
      <% if (accessories = @mutation.install&.accessories).present? %>
        <dl class="spec">
          <% accessories.each do |a| %>
            <div><dt>accessory</dt><dd class="mono"><%= a["name"] %> · <%= a["image"] %></dd></div>
          <% end %>
        </dl>
        <p class="note">Brought up first, on a network only <%= @mutation.install.name %>
          joins. Already-running ones are left alone.</p>
      <% end %>
    <% end %>

    <p class="note">Issues <code><%= @mutation.command %></code> over scoped SSH<%= " (spec on stdin)" if @mutation.stdin %>.</p>

    <%# Said before the press, not after the failure — and a warning, never a block. A box
        authorized a minute ago has not been observed yet and would read exactly like this,
        so refusing to try would be wrong (decisions/open/what-could-go-wrong.md). The act
        is still yours to witness; this only makes sure it isn't a surprise. %>
    <% if @machine.never_reached? && @machine.authorize_command %>
      <div class="ceremony-warn">
        <p class="note"><%= icon "triangle-alert", size: 14 %>
          <strong><%= @machine.name %> has never answered Steward.</strong> If its
          authorize line hasn't been run on the box yet, this act will fail to connect.
          Run it there first:</p>
        <%= command_block(@machine.authorize_command) %>
      </div>
    <% end %>

    <% confirm = { act: @mutation.act.verb, install_id: @mutation.install&.id, from: @from } %>
    <% confirm.merge!(image: @mutation.image, hostname: @mutation.hostname, port: @mutation.port, health: @mutation.health) if @mutation.needs_compose? %>
    <div class="ceremony-actions">
      <%= button_to safe_join([ icon("check", size: 14), "Confirm — write & run" ]),
            machine_mutation_path(@machine), method: :post, class: "btn mutate", params: confirm %>
      <%= link_to "Cancel", @return_path,
            class: "btn-quiet", data: { turbo_frame: "ceremony" } %>
    </div>
  </div>
<% end %>
