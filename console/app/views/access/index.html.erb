<% content_for :title, "Access — Steward" %>

<%= page_header "Access" do %>
  <%# Re-reads every box. A POST: it opens an SSH connection per machine, and a GET
      must be safe to repeat unasked. %>
  <%= button_to refresh_access_path(q: @q.presence, group: @group), class: "btn" do %>
    <%= safe_join([ icon("rotate-cw", size: 14), "Re-read" ]) %>
  <% end %>
<% end %>

<% if Machine.none? %>
  <p class="empty">No machines yet. <%= link_to "Add one", new_machine_path %>.</p>
<% else %>
  <%# Every box's ledger loads here, after the page is on screen, read in parallel. The
      headline, the search and the list all come with it: each is about what was read. %>
  <%= turbo_frame_tag "access-live", src: live_access_path(q: @q.presence, group: @group), target: "_top" do %>
    <div class="reading-box" role="status">
      <p class="reading-line"><span class="reading-prompt">$</span> steward actors --json<span class="reading-cursor" aria-hidden="true"></span></p>
      <p class="muted">Reading the ledger on <%= pluralize(Machine.count, "box", plural: "boxes") %> over scoped SSH…</p>
    </div>
  <% end %>
<% end %>
