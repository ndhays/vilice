<% content_for :title, "Record — Vilice" %>

<h1><%= icon "disc", size: 20 %> Record</h1>

<%# The filter. Four dimensions, all ANDed: who / what / for whom / when, plus free
    text. A plain GET form, so any filtered record is a shareable link. The text box
    still accepts the selector grammar (actor=alice target=node-001 project="Acme
    Corp") for a hand-written link, but the dropdowns beside it mean nobody has to
    learn it to narrow the record. %>
<%= form_with url: record_path, method: :get, class: "filter-bar" do |f| %>
  <span class="filter-search">
    <%= icon "search", size: 15 %>
    <%= f.search_field :q, value: @q, autocomplete: "off", spellcheck: false,
          placeholder: "Search the record",
          title: %(Free text, or a selector: actor=alice target=node-001 project="Acme Corp") %>
  </span>

  <%= f.select :actor, options_for_select([ [ "Anyone", "" ] ] + @actors, @actor),
        {}, class: "filter-select", onchange: "this.form.requestSubmit()" %>
  <%= f.select :project_id,
        options_for_select([ [ "Any project", "" ] ] + @projects.map { |p| [ p.name, p.id ] }, @project&.id),
        {}, class: "filter-select", onchange: "this.form.requestSubmit()" %>
  <%= f.select :since,
        options_for_select([ [ "All time", "" ] ] + RecordController::RANGES.keys.map { |k| [ "Last #{k}", k ] }, @since),
        {}, class: "filter-select", onchange: "this.form.requestSubmit()" %>
  <%= f.submit "Search", class: "btn" %>
  <% if filtered? %>
    <%= link_to "Clear", record_path, class: "filter-clear" %>
  <% end %>

  <%# Action — multi-select pills rather than a fourth dropdown, because picking two
      or three at once is the normal forensic move ("show me deploys and rollbacks").
      Each pill wears the same glyph the matching entry wears in the timeline below,
      so the filter and the result are visibly the same vocabulary. %>
  <% if @actions.any? %>
    <div class="action-filter">
      <span class="filter-label">Action</span>
      <div class="action-chips">
        <% @actions.each do |a| %>
          <label class="chip <%= "on" if @picked.include?(a) %>">
            <%= check_box_tag "actions[]", a, @picked.include?(a), onchange: "this.form.requestSubmit()" %>
            <%= icon action_icon_name(a), size: 13 %><%= a %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<p class="result-count muted">
  <%= pluralize(@chain.size, "entry", plural: "entries") %><%= " in the last #{@since}" if @since %><%= " · #{@picked.to_sentence}" if @picked.any? %><%= " · by #{@actor}" if @actor %><%= " · #{@project.name}" if @project %><%= " · matching “#{@q}”" if @q.present? %>
</p>

<% if @chain.empty? && filtered? %>
  <p class="empty">No acts match this filter. <%= link_to "Clear it", record_path %>.</p>
<% else %>
  <%= render "events/chain", items: @chain %>
<% end %>
