<%# The record, as a list of what happened — newest first (decisions/two-records.md).
    Each entry is one named actor doing one act at one time, and it reads in that
    order: what happened, then who did it and where, then when.

    Deliberately *not* drawn as a connected chain. The entries share a record, not a
    causal thread — a label edit on one project and a deploy on another box are
    neighbours by clock alone — so a rail between them drew a relationship that
    isn't there. Separation is a hairline, the way a list of unrelated things is
    normally separated. Mutations carry the amber glyph; acts only *witnessed* from
    the box record (not issued here) are marked as such. %>
<% within = local_assigns[:within] %>
<% if items.any? %>
  <ol class="chain">
    <% items.each do |item| %>
      <li class="chain-entry<%= " is-#{item.outcome}" if item.outcome.present? %>">
        <span class="chain-dot"><%= icon event_icon_name(item), size: 16 %></span>
        <div class="chain-body">
          <div class="chain-line">
            <%# Verb first and in bold, then what it touched. Two columns of the record,
                shown as two parts of one sentence — the glyph alone never said which
                act this was. %>
            <%# An act that ran a steward command leads with a stamp of that command — the
                button that was pressed, drawn flat so it cannot be pressed again. How it
                reached the box sets the stamp: filled when this console sent it, dashed and
                loud when someone typed it at the box, outlined for any other key. An act
                recorded here that sent nothing keeps its plain past-tense verb. %>
            <span class="chain-what"><%
              if item.via %><%= act_stamp(item) %><% else %><span class="chain-act"><%= item.action %></span><% end
              %><% if (detail = act_detail(item)).present? %> <%= detail %><% end %></span>
            <% case item.via %>
            <% when :by_hand %>
              <span class="tag by-hand" title="Typed at the box's own shell, not sent through a scoped key">run by hand on the box</span>
            <% when :key %>
              <span class="tag witnessed" title="Seen in the box record — sent by another key, not this console">witnessed</span>
            <% end %>
            <%= outcome_tag(item) %>
          </div>
          <div class="chain-meta">
            by <span class="chain-actor mono"><%= item.actor %></span>
            <% if (ctx = event_context(item, within: within)) %> · <%= ctx %><% end %>
          </div>
          <%# The entry's lower levels. The line above is the plain reading; this is the
              exact one — the command that ran, in bold — and it opens to the raw: what
              the box replied, and the record entry as stored. An act recorded here that
              sent nothing to a box says so rather than inventing a command. %>
          <% if item.entry.present? || item.command.present? %>
            <details class="chain-raw">
              <summary>
                <% if item.command.present? %>
                  <code class="chain-cmd"><%= item.command %></code>
                <% else %>
                  <span class="muted">recorded here · no command sent to a box</span>
                <% end %>
              </summary>
              <% unless item.output.nil? %>
                <p class="raw-label">Output</p>
                <pre class="raw"><%= item.output.is_a?(String) ? item.output : JSON.pretty_generate(item.output) %></pre>
              <% end %>
              <% if item.entry.present? %>
                <p class="raw-label">Raw record entry</p>
                <pre class="raw"><%= JSON.pretty_generate(item.entry.as_json) %></pre>
              <% end %>
            </details>
          <% end %>
        </div>
        <time class="chain-when" title="<%= item.at %>"><%= time_ago_in_words(item.at) %> ago</time>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="empty">Nothing recorded yet.</p>
<% end %>
