<%# The trail follows tenancy when there is any: through the client that owns this
    work, else straight down from Apps. Placement stands on its own — an app
    with no project is not an app missing one (decisions/console-layers.md). %>
<% content_for :title, [ @app.name, @project&.name, "Vilice" ].compact.join(" — ") %>

<% if @project %>
  <%= breadcrumb [["Projects", projects_path], [@project.name, project_path(@project)], [@app.name, nil]] %>
<% else %>
  <%= breadcrumb [["Apps", apps_path], [@app.name, nil]] %>
<% end %>

<h1 class="machine-head">
  <%= icon "box", size: 22 %>
  <span class="machine-name"><%= @app.name %></span>
  <%= app_state_badge(@app) %>
</h1>
<%# One line of facts: whose work it is, what it runs, and where it answers. %>
<p class="addr machine-facts">
  <% if @project %><%= link_to @project.name, @project %> · <% end %>
  <% if @app.app_template %>
    <%= link_to @app.app_template.name, @app.app_template %><% if @app.version %> ·
      <span class="mono"><%= @app.version.tag %></span><% end %>
  <% else %>
    custom image
  <% end %>
  <% if @app.hostname.present? %> · <span class="mono"><%= @app.hostname %></span><% end %>
  <% if @app.volumes.any? %>
    · <%= icon "hard-drive", size: 13 %>
    <%= safe_join(@app.volumes.map { |v| tag.span(v, class: "mono") }, " ") %>
  <% end %>
</p>

<%# ── The intention ─────────────────────────────────────────────────────────
    What was *asked for*, kept deliberately apart from the panel below, which is what
    the boxes report. Two visibly different things, because the moment they read as one
    the distinction that makes drift meaningful disappears
    (decisions/drift-is-surfaced-never-closed.md).

    Nothing here reconciles. The gap is stated and a person closes it, or it stays open. %>
<div class="panel intent">
  <div class="panel-head">
    <div class="kicker">Intention · asked for, not observed</div>
    <%= button_link_to "Change the ask", edit_app_path(@app),
          icon: "pencil", class: "btn-quiet panel-action" %>
  </div>
  <p class="intent-head"><%= placement_gap_line(@app, verbose: true) %></p>
  <p class="note muted"><%= placement_gap_word(@app) %></p>

  <%# Exposure is the reason a count is or is not allowed above one, so it reads as a
      chip on the intention rather than as a paragraph teaching the model. %>
  <p class="intent-facts">
    <span class="intent-fact">
      <%= icon @app.exposure_edge? ? "edge" : "network", size: 13 %>
      <%= @app.exposure_edge? ? "On the edge — one box" : "Behind a balancer" %>
    </span>
    <% unless @app.replicable? %>
      <span class="intent-fact">
        <%= icon "hard-drive", size: 13 %> Single-placement — it keeps data
      </span>
    <% end %>
  </p>

  <%# Whether the gap can be closed *now* is a second question, and it has a different
      answer from "is there a gap" — one is a click, the other is go get a box. The
      button used to appear on any negative gap and could lead to a page that had
      nothing to offer. Still nothing here acts: it says which of the two you are in.

      "Another" is only true once there is one; an app can be created with no box
      at all, so the first placement is the common first thing this button ever does. %>
  <% if @app.short? %>
    <% candidates = @app.candidate_machines %>
    <% ready = candidates.select(&:reached?) %>
    <% if candidates.any? %>
      <p><%= button_link_to @placements.any? ? "Place on another box" : "Place on a box",
               new_app_placement_path(@app), icon: "plus", class: "btn" %></p>
      <p class="note muted">
        <% if ready.any? %>
          <%= pluralize(ready.size, "box") %> ready to take it<%
            %><% if (waiting = candidates.size - ready.size).positive? %>,
            and <%= waiting %> not yet authorized<% end %>.
          Last read, not a live check.
        <% else %>
          <%= pluralize(candidates.size, "box is", plural: "boxes are") %> free, but
          <%= candidates.one? ? "it has" : "none has" %> answered us yet — run the
          authorize line on the box before deploying to it.
        <% end %>
      </p>
    <% else %>
      <%# The gap is real and there is nowhere to put it. Naming the fix beats a button
          that leads to an empty picker. %>
      <p class="note muted">No box is free to take this
        <%= "on #{@app.project.name}" if @app.project %> — every operate-scoped
        box already runs it, or there are none.
        <%= link_to "Add a machine", new_machine_path(project_id: @app.project&.id) %>.</p>
    <% end %>
  <% end %>
</div>

<%# Where it runs — each live target box, its state, image drift, and the witnessed
    verbs. This half is *reality*: the box's own report, reconciled by observe. The
    App is the app-actions home; the act still runs on the box (the SSH target), and
    returns here. See decisions/install-the-app-actions-home.md. %>
<div class="panel mutate">
  <div class="kicker">Where it runs · witnessed</div>
  <% if @placements.any? %>
    <ul class="acts-apps">
      <% @placements.each do |placement| %>
        <li class="acts-app">
          <span class="acts-app-name">
            <%= icon "hard-drive", size: 13 %>
            <%= link_to placement.machine.name, placement.machine %>
            <span class="badge state-<%= placement.state %>"><%= placement.state %></span>
            <%# Logs sit with the box's name, not with the verbs, because they are not
                one: reading is `observe` and every verb below is `operate`. That is why
                this is offered on a box whose key cannot act — the moment you most want
                to look is the moment you are least able to touch. %>
            <% unless placement.machine.seen_unreachable? %>
              <%= link_to safe_join([ icon("file-text", size: 12), "Logs" ]),
                    machine_logs_path(placement.machine, app_id: @app.id),
                    class: "logs-link", data: { turbo_frame: "logs" } %>
            <% end %>
          </span>
          <% if placement.machine.operate? %>
            <%= render "apps/acts", app: @app, machine: placement.machine, from: "app" %>
          <% else %>
            <span class="acts-app-verbs note muted">observe only — grant operate to act here</span>
          <% end %>
        </li>
        <div class="placement-image">
          <% if placement.in_sync? %>
            running <%= digest_chip(placement.current_image) %>
          <% elsif placement.current_image.present? %>
            running <%= digest_chip(placement.current_image) %>
            · desired <%= digest_chip(placement.desired_image) %> <span class="drift-word">drift</span>
          <% elsif placement.desired_image.present? %>
            desired <%= digest_chip(placement.desired_image) %>, not yet running
          <% else %>
            <%= digest_chip(@app.image) %>
          <% end %>
        </div>
      <% end %>
    </ul>
  <% else %>
    <p class="note">Not placed on a box yet.</p>
  <% end %>
</div>

<%# The ceremony lands here: pick a verb above → this frame fills with the preview
    of the exact record line, then Confirm writes & runs it. %>
<%= turbo_frame_tag "ceremony" %>

<%# ── Configuration ─────────────────────────────────────────────────────────
    The values behind the names the app declares. Present only when it declares
    something — a section that could only ever say "None" is absent instead.

    A read of this page never shows a stored secret. The panel says whether a value is
    held and nothing more; the value goes out on stdin to a box and comes back nowhere. %>
<% if @app.plain_env_names.any? || @app.declared_secret_names.any? %>
  <div class="panel config">
    <div class="panel-head">
      <div class="kicker">Configuration · values behind the declared names</div>
      <% if (missing = @app.missing_secrets).any? %>
        <span class="panel-action note muted"><%= icon "triangle-alert", size: 13 %>
          <%= pluralize(missing.size, "value") %> still needed</span>
      <% end %>
    </div>
    <%= form_with url: configure_app_path(@app), method: :patch, scope: :app,
          class: "stack-form" do |f| %>
      <%= render "apps/env_fields", app: @app, f: f %>
      <div class="form-actions">
        <%= button_tag class: "btn" do %>
          <%= safe_join([ icon("save", size: 14), "Save Configuration" ]) %>
        <% end %>
        <span class="note muted">Nothing is deployed by saving — that is still an act.</span>
      </div>
    <% end %>
  </div>
<% end %>

<%# Logs land in their own frame, kept apart from the ceremony's: one is the violet
    "this will be recorded" zone and the other is a plain read, and a reader should
    never have to work out which of the two they are looking at. Empty until asked —
    every tail is an SSH round trip. %>
<%= turbo_frame_tag "logs" %>

<h2 class="section-kicker">
  <%= icon "disc", size: 15 %> Record
  
</h2>
<%= form_with url: app_path(@app), method: :get, class: "filter-bar" do |f| %>
  <span class="filter-search">
    <%= icon "search", size: 15 %>
    <%= f.search_field :q, value: @q, autocomplete: "off", spellcheck: false,
          placeholder: "Search this app's record" %>
  </span>
  <%= f.submit "Search", class: "btn sm" %>
  <% if @q.present? %>
    <%= link_to "Clear", app_path(@app), class: "filter-clear" %>
  <% end %>
<% end %>
<% if @chain.empty? && @q.present? %>
  <p class="empty">Nothing in this record matches. <%= link_to "Clear it", app_path(@app) %>.</p>
<% else %>
  <%= render "events/chain", items: @chain, within: @project %>
<% end %>
