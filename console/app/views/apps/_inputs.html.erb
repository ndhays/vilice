<%# The app's declared inputs — env vars (some secret) and secret files. Names only; the
    operator supplies values at install. "Secrets are env vars": one list, a secret flag.
    Saving is a recorded own-record act (apps#update).

    **The declaration read back is the resting state; editing is a deliberate act.** The
    chip editor is quick to toggle and hard to audit, and the mistake that matters is a
    variable that should have been marked secret and was not — its value is then written
    to an append-only record and cannot be taken back. So what you see by default is the
    auditable form: two alphabetical columns, split by what actually happens to the value.
    Edit reveals the chips in place; the form stays in the DOM either way, so toggling
    never discards an in-progress edit. %>
<div class="inputs" data-controller="env-editor">
  <div class="panel-head">
    <div class="kicker">Environment</div>
    <button type="button" class="btn-quiet panel-action inputs-toggle" data-action="env-editor#toggle">
      <%= icon "pencil", size: 13, css_class: "icon icon-edit" %><%
        %><%= icon "check", size: 13, css_class: "icon icon-done" %><%
        %><span data-env-editor-target="toggleText">Edit</span>
    </button>
  </div>

  <%# ── The declaration, read back ─────────────────────────────────────────────
      Alphabetical so it can be scanned for a name, and split by consequence rather
      than by the word "secret" — the failure is not knowing what the flag does. %>
  <div class="declared">
    <div class="declared-cols">
      <div class="declared-col">
        <h4><%= icon "file-text", size: 13 %> Written to the record
          <span class="declared-count"><%= app.env_recorded.size %></span></h4>
        <% if app.env_recorded.any? %>
          <ul class="declared-list mono">
            <% app.env_recorded.each do |key| %><li><%= key %></li><% end %>
          </ul>
        <% else %>
          <p class="declared-none">No plain variables.</p>
        <% end %>
      </div>

      <div class="declared-col is-secret">
        <h4><%= icon "lock", size: 13 %> Never recorded
          <span class="declared-count"><%= app.env_off_record.size + app.secret_files.size %></span></h4>
        <% if app.env_off_record.any? || app.secret_files.any? %>
          <ul class="declared-list mono">
            <% app.env_off_record.each do |key| %><li><%= key %></li><% end %>
            <%# Files are off-record by definition, so they belong in this column — marked
                as files, because a path is a different kind of thing from a variable. %>
            <% app.secret_files.sort_by { |f| f["name"].to_s }.each do |f| %>
              <li class="is-file">
                <%= icon "file-text", size: 11 %><%= f["name"] %>
                <span class="declared-path"><%= f["path"] %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="declared-none">No secrets.</p>
        <% end %>
      </div>
    </div>
    <p class="declared-note">
      Values are supplied at install. All keys are stored in the record, but only the
      values on the left. Values for everything on the right do not appear in the record.
    </p>
  </div>

  <%# ── The editor, revealed ──────────────────────────────────────────────────── %>
  <%= form_with model: app, class: "inputs-form",
        data: { env_editor_target: "form", action: "input->env-editor#touch" } do %>
    <%# Says "the editor posted this", so no rows means none — see apps#app_params. %>
    <%= hidden_field_tag "app[inputs_form]", "1" %>
    <% if app.errors.any? %>
      <div class="flash alert"><%= app.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="kicker sub">Variables</div>
    <p class="muted form-note">
      Names only. Click one to mark it secret — a secret reaches the box off-record.
    </p>
    <div class="chips" data-env-editor-target="envChips">
      <% app.env.each_with_index do |e, i| %>
        <%= render "apps/env_chip", i: i, key: e["key"], secret: e["secret"] %>
      <% end %>
    </div>
    <div class="chip-add">
      <input type="text" data-env-editor-target="envInput" data-action="keydown->env-editor#keydown"
             placeholder="VARIABLE_NAME" class="mono" autocomplete="off" spellcheck="false">
      <button type="button" class="btn-quiet" data-action="env-editor#addEnv">
        <%= icon "plus", size: 13 %> Add Variable
      </button>
    </div>

    <div class="kicker sub">Secret Files</div>
    <p class="muted form-note">
      Files the app needs mounted — a config, an htpasswd. Name and absolute path;
      the contents are supplied at install, off-record.
    </p>
    <div class="kv-list" data-env-editor-target="fileList">
      <% app.secret_files.each_with_index do |f, i| %>
        <%= render "apps/file_row", i: i, name: f["name"], path: f["path"] %>
      <% end %>
    </div>
    <button type="button" class="btn-quiet kv-add" data-action="env-editor#addFile">
      <%= icon "plus", size: 13 %> Add File
    </button>

    <%# ── Accessories ──────────────────────────────────────────────────────────
        The database or cache this app needs on the same box. Reachable by this app and
        nothing else — no hostname, no published port, its own network
        (decisions/accessories-belong-to-one-app.md). %>
    <div class="kicker sub">Accessories</div>
    <p class="muted form-note">
      Containers this app needs beside it. Each gets a name the app dials it by
      (<span class="mono">db:5432</span>), on a network only this app joins — nothing else
      on the box can reach it. Images are digest-pinned like the app's, and a volume keeps
      the data across deploys.
    </p>
    <div class="acc-list" data-env-editor-target="accessoryList">
      <% app.accessories.each_with_index do |a, i| %>
        <%= render "apps/accessory_row", i: i, name: a["name"], image: a["image"],
              volumes: Array(a["volumes"]).join("\n"),
              env: Hash(a["env"]).map { |k, v| "#{k}=#{v}" }.join("\n"),
              secrets: Array(a["secrets"]).join(" ") %>
      <% end %>
    </div>
    <button type="button" class="btn-quiet kv-add" data-action="env-editor#addAccessory">
      <%= icon "plus", size: 13 %> Add Accessory
    </button>

    <div class="form-actions"><%= submit_tag "Save Inputs", class: "btn mutate" %></div>
  <% end %>

  <template data-env-editor-target="envTemplate"><%= render "apps/env_chip", i: "NEW", key: "KEYNAME", secret: false %></template>
  <template data-env-editor-target="fileTemplate"><%= render "apps/file_row", i: "NEW", name: nil, path: nil %></template>
  <template data-env-editor-target="accessoryTemplate"><%= render "apps/accessory_row", i: "NEW", name: nil, image: nil, volumes: nil, env: nil, secrets: nil %></template>
</div>
