<%= form_with model: app, class: "stack-form" do |f| %>
  <% if app.errors.any? %>
    <div class="flash alert"><%= app.errors.full_messages.to_sentence %></div>
  <% end %>

  <label class="field">
    <span>Name <%= hint "Letters, digits, dashes, underscores. It becomes the app's name on the box." %></span>
    <%= f.text_field :name, required: true, autocomplete: "off",
          pattern: "[A-Za-z0-9_-]+", title: "Letters, digits, dashes, and underscores only" %>
  </label>
  <p class="muted form-note">Images live on <em>versions</em> — add one after you create the app.</p>
  <div class="field-row">
    <label class="field"><span>Port <%= hint "The port the app listens on inside its container. 1024–65535: lower ports need root, and the app runs unprivileged." %></span>
      <%= f.number_field :port, placeholder: "8080", min: 1024, max: 65535 %></label>
    <label class="field"><span>Health Path <%= hint "A path that returns 200 when the app is healthy. Deploy waits for it before routing traffic." %></span>
      <%= f.text_field :health, class: "mono", placeholder: "/up", pattern: "/.*",
            title: "A path starting with /" %></label>
  </div>
  <label class="field">
    <span>Description</span>
    <%= f.text_field :description, autocomplete: "off" %>
  </label>

  <%# Typed as a line, stored as argv. The box never runs it through a shell, so the
      note says what to do instead of pretending `&&` will work. %>
  <label class="field">
    <span>Release Command <%= hint "Run once from the new image before the new container starts — migrations are what this is for. If it fails, nothing is deployed and the running app is untouched." %></span>
    <%= text_field_tag "app[release_line]", app.release.join(" "), class: "mono",
          autocomplete: "off", spellcheck: false, placeholder: "bin/rails db:migrate" %>
    <small class="muted">Optional. One command and its arguments — <strong>no shell</strong>,
      so <span class="mono">&amp;&amp;</span> and pipes will not work. For more than one
      step, put a script in the image (<span class="mono">bin/release</span>) and name it
      here, where the image digest covers what it does.</small>
  </label>

  <div class="form-actions">
    <%= f.submit class: "btn mutate" %>
    <%# Cancel returns where you came from: the app when editing, the library when new. %>
    <%= button_link_to "Cancel", (app.persisted? ? app : apps_path), class: "btn-quiet" %>
  </div>
<% end %>
