<% content_for :title, "Edit #{@project.name} — Steward" %>

<%= breadcrumb [ [ "Projects", projects_path ], [ @project.name, project_path(@project) ], [ "Edit", nil ] ] %>
<h1>Edit <%= @project.name %></h1>

<%= form_with model: @project, class: "stack-form" do |f| %>
  <% if @project.errors.any? %>
    <div class="flash alert"><%= @project.errors.full_messages.to_sentence %></div>
  <% end %>

  <label class="field"><span>Project Name</span>
    <%= f.text_field :name, required: true, autocomplete: "off" %></label>
  <div class="field-row">
    <label class="field"><span>Contact Name</span>
      <%= f.text_field :contact_name, autocomplete: "off" %></label>
    <label class="field"><span>Contact Email</span>
      <%= f.email_field :contact_email, class: "mono", autocomplete: "off" %></label>
  </div>

  <div class="form-actions">
    <%= button_tag class: "btn mutate" do %>
      <%= safe_join([ icon("save", size: 14), "Save Changes" ], " ") %>
    <% end %>
    <%= button_link_to "Cancel", project_path(@project), class: "btn-quiet" %>
  </div>
<% end %>
