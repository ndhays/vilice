<% content_for :title, "#{@project.name} — Steward" %>

<%= breadcrumb [["Projects", projects_path], [@project.name, nil]] %>

<h1 class="machine-head">
  <%= icon "handshake", size: 22 %>
  <span class="machine-name"><%= @project.name %></span>
  <%# Star is a focus lens, not a setting — it stays where you can reach it. Edit and
      Delete moved to the settings section at the foot: a destructive control does not
      belong in a page title. %>
  <%= button_to star_project_path(@project), method: :patch,
        class: "star-btn #{'on' if @project.starred?}" do %>
    <%= icon "star", size: 15 %><%= @project.starred? ? "Unstar" : "Star" %>
  <% end %>
</h1>

<%# A verdict, always — the Status page's answer, scoped to one client. Either there
    is something to deal with or there is not, and the page says which before it says
    anything else. The counts sit underneath as the proof it was looked at. %>
<% trouble = [] %>
<% trouble << "#{pluralize(@needs_look, 'app')} #{@needs_look == 1 ? 'needs' : 'need'} a look" if @needs_look.positive? %>
<% trouble << "#{pluralize(@down_boxes, 'box', plural: 'boxes')} unreachable" if @down_boxes.positive? %>
<% trouble << "#{pluralize(@short, 'app')} short of the ask" if @short.positive? %>
<div class="verdict <%= trouble.any? ? 'bad' : 'ok' %>">
  <%= icon(trouble.any? ? "triangle-alert" : "circle-check", size: 26) %>
  <div>
    <p class="verdict-head"><%= trouble.any? ? trouble.join(" · ") : "Nothing to report" %></p>
    <p class="verdict-sub">
      <%= pluralize(@apps.size, "app") %> ·
      <%= pluralize(@owned_machines.size + @shared_machines.size, "machine") %><%
        %><%= " · all running as asked" if trouble.empty? && @apps.any? %>
    </p>
  </div>
</div>

<% if @project.contact_name.present? || @project.contact_email.present? %>
  <p class="addr machine-facts">
    <%= @project.contact_name %><% if @project.contact_email.present? %>
      <% if @project.contact_name.present? %>·<% end %>
      <span class="mono"><%= @project.contact_email %></span>
    <% end %>
  </p>
<% end %>
<div class="label-row"><%= render "labels/editor", labelable: @project %></div>

<%# Section order = altitude. At the project level the apps are the protagonist:
    Apps (what runs) → Machines (where it runs, the paired substrate) → Record
    (the project's ledger — bounded to a head + a link to the full filtered view).
    The record is the spine globally (Home/`/record`); here it's the footer ledger. %>
<div class="section-head">
  <h2>Apps</h2>
  <%= button_link_to "Add App", new_app_path(project_id: @project), icon: "plus", class: "btn" %>
</div>
<% if @apps.any? %>
  <ul class="rows app-rows">
    <%= render partial: "apps/row", collection: @apps, as: :app %>
  </ul>
<% else %>
  <p class="empty">No apps yet.</p>
<% end %>

<%# Owned — this project's own hardware. Owner is implied by the section, so the
    owner column is suppressed here. %>
<div class="section-head">
  <h2>Owned Machines</h2>
  <%= button_link_to "New Machine", new_machine_path(project_id: @project), icon: "plus", class: "btn" %>
</div>
<% if @owned_machines.any? %>
  <ul class="rows machine-rows">
    <%= render partial: "machines/row", collection: @owned_machines, as: :machine,
          locals: { show_owner: false } %>
  </ul>
<% else %>
  <p class="empty">No machines owned by this project yet.</p>
<% end %>

<%# Shared — boxes another project owns, shared with this one. The owner links out
    to the owning project (its context). Attach an existing permitted box below. %>
<% if @shared_machines.any? %>
  <div class="section-head">
    <h2>Shared Machines</h2>
  </div>
  <ul class="rows machine-rows">
    <%= render partial: "machines/row", collection: @shared_machines, as: :machine %>
  </ul>
<% end %>

<%# Attach an existing box this project is permitted on — a box it owns but hasn't
    linked yet, or one shared with it. The join enforces the guardrail server-side. %>
<% if @attachable.any? %>
  <%= form_with url: project_project_machines_path(@project), method: :post, class: "attach-row" do %>
    <%= select_tag :machine_id,
          options_from_collection_for_select(@attachable, :id, :name),
          prompt: "Attach an existing machine…", class: "select" %>
    <%= button_tag class: "btn sm" do %>
      <%= safe_join([ icon("plus", size: 14), "Attach" ]) %>
    <% end %>
  <% end %>
<% end %>

<h2 class="section-kicker">
  <%= icon "disc", size: 15 %> Record
  <% if @record_total > ProjectsController::RECORD_HEAD %>
    <%= link_to "Full Record →", record_path(q: %(project="#{@project.name}")), class: "section-link" %>
  <% end %>
</h2>
<%= form_with url: project_path(@project), method: :get, class: "filter-bar" do |f| %>
  <span class="filter-search">
    <%= icon "search", size: 15 %>
    <%= f.search_field :q, value: @q, autocomplete: "off", spellcheck: false,
          placeholder: "Search this client's record" %>
  </span>
  <%= f.submit "Search", class: "btn sm" %>
  <% if @q.present? %>
    <%= link_to "Clear", project_path(@project), class: "filter-clear" %>
  <% end %>
<% end %>
<% if @chain.empty? && @q.present? %>
  <p class="empty">Nothing in this record matches. <%= link_to "Clear it", project_path(@project) %>.</p>
<% else %>
  <%= render "events/chain", items: @chain, within: @project %>
<% end %>

<%# ── Project settings — the controls that configure this client rather than report
    on it. Behind a click, and at the foot: Delete was sitting in the page title. %>
<details class="page-settings">
  <summary>
    <%= icon "chevron-down", size: 16, css_class: "icon settings-caret" %>
    <%= icon "settings", size: 16 %>
    <span>Project Settings</span>
    <span class="muted">name, contact, and deletion</span>
  </summary>

  <div class="panel observe">
    <div class="panel-head">
      <div class="kicker">Details</div>
      <%= button_link_to "Edit", edit_project_path(@project), icon: "pencil",
            class: "btn-quiet panel-action" %>
    </div>
    <p class="note muted">The client's name and who to contact about their work.</p>
  </div>

  <%# Deleting is guarded server-side: a project that still has live apps or owns
      machines is refused, naming them. The confirm is the second gate, not the first. %>
  <div class="panel danger-remove">
    <h3 class="danger-head"><%= icon "trash-2", size: 15 %> Delete this Project</h3>
    <p class="note">Removing the client. Refused while it still has live apps or owns
      machines — take those off or transfer them first.</p>
    <%= button_to project_path(@project), method: :delete, class: "btn danger",
          form: { data: { turbo_confirm: "Delete #{@project.name}? This can't be undone." } } do %>
      <%= safe_join([ icon("trash-2", size: 14), %(Delete "#{@project.name}") ]) %>
    <% end %>
  </div>
</details>
