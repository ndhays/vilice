// get.vilice.org — the installer and the signed releases, and nothing else.
// Published by `make publish` from the repo root, never by a push: whatever this host
// serves, root runs, so putting it live is a deliberate act from a machine that holds
// the release (decisions/the-name-is-vilice.md).
{
  "name": "vilice-get",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist-get" },
  // One address. No workers.dev copy of the installer, and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [ { "pattern": "get.vilice.org", "custom_domain": true } ]
}
