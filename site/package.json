{
  "name": "vilice-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vilice documentation site, built with Web Origami.",
  "scripts": {
    "cli": "make -C ../vilice build",
    "prebuild": "npm run cli && node scripts/check-release.js",
    "preserve": "npm run cli",
    "build": "ori copy site.ori, clear files:dist",
    "serve": "ori serve site.ori"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@weborigami/origami": "^0.6.17"
  }
}
