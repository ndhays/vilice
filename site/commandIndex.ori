// The command index: every command, in the binary's own groups and order.
// One line each — the name and what it does. Everything else is one click away.
(commands) => {
  title: "Commands"
  nav: "commands"
  sidebar: true
  _body: `        <h1>Commands</h1>
        <p class="lead">Every verb this binary dispatches, in the order <code>steward help</code>
        shows them. Each page opens with that command's real <code>--help</code> output.</p>
        <p>A command's group is its scope: who may run it, and how far that reaches.
        The root ceiling sits outside the scoped-SSH ladder — those three commands
        change the <em>machine</em>, and no key can reach them. Everything else runs
        as the unprivileged <code>steward</code> user. See
        <a href="/index.html#authentication--scoped-ssh">Authentication</a>.</p>
${ Tree.map(Tree.groupBy(commands, (command) => command.group), (group, title) => `        <h2>${ title }</h2>
        <table class="commands">
          <tbody>
${ Tree.map(group, (command) => `            <tr>
              <td><a href="/commands/${ command.name }.html"><code>${ command.name }</code></a></td>
              <td>${ command.summary }</td>
            </tr>
`) }          </tbody>
        </table>
`) }`
}
