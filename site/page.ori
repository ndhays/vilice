// Shared HTML layout. Receives a markdown document (with front-matter `title`
// and rendered `_body`) and the versions object, and wraps them in the page
// chrome. Substitutions use ${ }; `??` supplies a default title.
//
// A plain template literal (not Tree.indent) is deliberate: indent would
// re-indent the multi-line ${ doc._body }, corrupting whitespace inside <pre>
// blocks like the ecosystem diagram. The body is inserted verbatim.
(doc, versions) => `<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${ doc.title ?? "Steward" } · Steward</title>
    <meta name="description" content="A coordination platform for operators running managed services on infrastructure they control.">
    <meta name="theme-color" content="#1c2230">
    <meta property="og:title" content="${ doc.title ?? "Steward" } · Steward">
    <meta property="og:type" content="website">
    <meta property="og:description" content="A coordination platform for operators running managed services on infrastructure they control.">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-banner" role="status">
      Steward is currently in BETA development. Use at your own risk! Code and project is subject to change.
    </div>
    <header class="site-header">
      <a class="brand" href="/index.html">Steward</a>
      <nav aria-label="Primary">
        <a href="/index.html">Documentation</a>
        <a href="/packs.html">Packs</a>
        <a href="/console.html">Console</a>
        <a href="https://github.com/ndhays/steward">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main">
      ${ doc._body }
    </main>
    <footer class="site-footer">
      <span class="versions">
        Steward v${ versions.platform }
      </span>
      <span class="meta">
        <a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0</a> (Console)
        &nbsp;·&nbsp;
        <a href="https://opensource.org/license/mit">MIT</a> (Steward)
        &nbsp;·&nbsp;
        Site built with <a href="https://weborigami.org">Web Origami</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/ndhays/steward">ndhays/steward</a>
      </span>
    </footer>
    <script src="/assets/copy.js" defer></script>
  </body>
</html>
`
