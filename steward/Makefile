# One platform version, at the repo root; injected into the binary via -ldflags.
VERSION      ?= $(shell cat ../VERSION)
LDFLAGS      := -X steward/internal/core.Version=$(VERSION)
PUBKEY       ?= release-key.pub
# ed25519 private signing key. Never committed — keep it offline. Make one with
# `make keygen`. The matching public key is committed at release-key.pub.
SIGNING_KEY  ?= $(HOME)/.keys/steward-release-key.pem
# Where `make release` publishes artifacts (rsync-compatible: local path or host:path).
RELEASE_DEST ?= $(CURDIR)/../release/published
# The architectures every release ships. Cheap to add to: the binary is CGO-free and
# go.mod requires nothing, so a second architecture is a second `go build` rather than
# a second toolchain. arm64 is not exotic — it is most of the cheap VPS stock now, and
# an installer that assumed amd64 put a binary on those boxes that could not run.
ARCHES       ?= amd64 arm64
# Pinned audit tools. Run via `go run` so they never enter go.mod or the binary.
# Keep these current with the Go toolchain — an old pin can fail to build under a
# newer Go (its own deps lag). Bump when `make audit` errors before scanning.
GOVULN_VER   ?= v1.3.0
GOSEC_VER    ?= v2.29.0

.PHONY: build build-linux man test fuzz vet fmt audit sign release keygen clean

# Host-arch dev build.
build:
	go build -ldflags "$(LDFLAGS)" -o bin/steward ./cmd/steward

# The man page, generated by the binary from its own command table — one source,
# so help, usage errors, and steward(1) cannot drift.
man: build
	bin/steward _man > bin/steward.1
	@man --warnings -l bin/steward.1 > /dev/null 2>&1 && echo "steward.1 renders clean" || true

# The binary for the box (linux/amd64), used by the dev push loop.
build-linux:
	CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags "$(LDFLAGS)" -o bin/steward-linux-amd64 ./cmd/steward

# Install the host-arch binary locally, for using steward on this machine.
# (The box gets it via install.sh — download + verify — not this.)
install: build man
	sudo install -m 0755 bin/steward /usr/local/bin/steward
	sudo install -D -m 0644 bin/steward.1 /usr/local/share/man/man1/steward.1
	@/usr/local/bin/steward version

test:
	go test ./...

# Run the gate's fuzz targets past their seed corpus. `make test` already runs every
# seed (including the checked-in regressions under testdata/fuzz/); this is the part
# that goes looking for the case nobody listed. FUZZTIME=5m for a longer hunt.
# A new failing input is written to testdata/fuzz/ — commit it, it's a regression test.
# See decisions/security-audit.md and decisions/rendered-config-is-a-boundary.md.
FUZZTIME ?= 30s
fuzz:
	@for t in $$(go test -list 'Fuzz.*' ./... | grep '^Fuzz'); do \
	  echo "=== $$t ($(FUZZTIME)) ==="; \
	  go test -run '^$$' -fuzz "^$$t$$" -fuzztime $(FUZZTIME) ./... || exit 1; \
	done

vet:
	go vet ./...

fmt:
	go fmt ./...

# Static security audit. Kept out of `build` (it needs the network and is slower);
# it gates `release` instead — a version doesn't ship unless it passed.
#   govulncheck — known CVEs in the stdlib/deps the code actually calls. A finding here
#     usually means the build toolchain is behind: bump Go to the latest patch release.
#   gosec — Go security anti-patterns. The perms/path rules (G301/G302/G304/G306) are
#     excluded by policy: Steward deliberately keeps the record world-readable (observe
#     is zero-privilege + off-host shipping), ships conventional 0644 systemd units, and
#     only ever opens its own configured paths. The subprocess rule G204 stays on and is
#     annotated per call site. See decisions/security-audit.md.
audit:
	go run golang.org/x/vuln/cmd/govulncheck@$(GOVULN_VER) ./...
	go run github.com/securego/gosec/v2/cmd/gosec@$(GOSEC_VER) -quiet -exclude=G301,G302,G304,G306 ./...

# Build the release binary, tar it, sign it (ed25519), and self-verify. A bad
# signature fails here rather than shipping silently.
sign: man
	@test -f "$(SIGNING_KEY)" || { \
	  echo "signing key not found at $(SIGNING_KEY)"; \
	  test ! -f "$(HOME)/.keys/hostler-release-key.pem" || { \
	    echo "  a pre-rename key is still at ~/.keys/hostler-release-key.pem — move it:"; \
	    echo "    mv ~/.keys/hostler-release-key.pem $(SIGNING_KEY)"; \
	    echo "  (do NOT run 'make keygen' — a new key invalidates published signatures)"; }; \
	  test -f "$(HOME)/.keys/hostler-release-key.pem" || echo "  first time? run: make keygen"; \
	  exit 1; }
	mkdir -p dist/$(VERSION)
	@# One tarball per architecture, and one signature per tarball. Never one
	@# signature covering several artifacts: a signature has to name exactly the
	@# bytes it vouches for, or verifying it proves nothing about what you ran.
	@for arch in $(ARCHES); do \
	  echo "=== linux/$$arch ==="; \
	  CGO_ENABLED=0 GOOS=linux GOARCH=$$arch \
	    go build -ldflags "$(LDFLAGS)" -o dist/$(VERSION)/steward ./cmd/steward || exit 1; \
	  cp bin/steward.1 dist/$(VERSION)/steward.1; \
	  tar -czf dist/$(VERSION)/steward-linux-$$arch.tar.gz -C dist/$(VERSION) steward steward.1 || exit 1; \
	  rm -f dist/$(VERSION)/steward dist/$(VERSION)/steward.1; \
	  openssl pkeyutl -sign -rawin -inkey "$(SIGNING_KEY)" \
	    -in  dist/$(VERSION)/steward-linux-$$arch.tar.gz \
	    -out dist/$(VERSION)/steward-linux-$$arch.tar.gz.sig || exit 1; \
	  openssl pkeyutl -verify -rawin -pubin -inkey "$(PUBKEY)" \
	    -in  dist/$(VERSION)/steward-linux-$$arch.tar.gz \
	    -sigfile dist/$(VERSION)/steward-linux-$$arch.tar.gz.sig \
	    && echo "  signature verified" || { echo "  signature verification FAILED"; exit 1; }; \
	done
	@ls -lh dist/$(VERSION)/

# Publish the signed artifacts. Audited first — an unaudited version never ships.
release: audit sign
	mkdir -p "$(RELEASE_DEST)/steward/$(VERSION)"
	@for arch in $(ARCHES); do \
	  cp dist/$(VERSION)/steward-linux-$$arch.tar.gz     "$(RELEASE_DEST)/steward/$(VERSION)/" || exit 1; \
	  cp dist/$(VERSION)/steward-linux-$$arch.tar.gz.sig "$(RELEASE_DEST)/steward/$(VERSION)/" || exit 1; \
	done
	@echo "published $(VERSION) ($(ARCHES)) to $(RELEASE_DEST)/steward/$(VERSION)/"

# Generate a fresh signing keypair (do once; keep the private key safe).
# Guarded: rotating the key invalidates every signature already published, and
# every box that verified against the old release-key.pub. Refuses to overwrite an
# existing keypair unless you say FORCE=1 and mean it.
keygen:
	@test ! -f release-key.pub -o -n "$(FORCE)" || { \
	  echo "release-key.pub already exists — generating a new key would invalidate"; \
	  echo "every published signature. If that is really what you want: make keygen FORCE=1"; \
	  exit 1; }
	@test ! -f $(SIGNING_KEY) -o -n "$(FORCE)" || { \
	  echo "$(SIGNING_KEY) already exists — refusing to overwrite it (FORCE=1 to override)"; \
	  exit 1; }
	@mkdir -p $(HOME)/.keys
	umask 077 && openssl genpkey -algorithm ed25519 -out $(SIGNING_KEY)
	openssl pkey -in $(SIGNING_KEY) -pubout -out release-key.pub
	@echo "private: $(SIGNING_KEY)  (keep offline, never commit)"
	@echo "public:  release-key.pub  (commit this)"

clean:
	rm -rf bin dist
